---
import Base from '../layouts/Base.astro';
---
<Base title="PyOrex — Exploration intelligence & geoscience tools">
<section class="homehero"><div class="wrap homegrid"><div><div class="eyebrow" data-i18n="homeEyebrow">PYOREX · GEOSCIENCE ECOSYSTEM</div><h1><span data-i18n="homeTitle">Explore smarter.</span><br/><span data-i18n="homeTitle2">Understand deeper.</span></h1><p data-i18n="homeDesc">Open geoscience software and curated exploration intelligence, built around the way exploration geologists actually work.</p><div class="actions"><a class="btn gold" href="/hub" data-i18n="homeHub">Enter PyOrex HUB →</a><a class="btn" href="/software" data-i18n="homeSoftware">PyOrex Software</a></div><div class="signals"><span>ECONOMIC GEOLOGY</span><span>MINERAL EXPLORATION</span><span>DATA & INTERPRETATION</span></div></div><div class="visual"><div class="orb"></div><div class="trace t1"></div><div class="trace t2"></div><div class="float f1"><small>EXPLORATION INTELLIGENCE</small><b>Signal over noise.</b></div><div class="float f2"><small>PYOREX SOFTWARE</small><b>Tools for geologists.</b></div></div></div></section>
<section class="ecosystem" style="display:none"><div class="wrap"><div class="intro"><div><div class="eyebrow" data-i18n="homeEco">ONE ECOSYSTEM · TWO SIDES</div><h2 data-i18n="homeFrom">From data to discovery.</h2></div><p data-i18n="homeEcoDesc">PyOrex connects practical geoscience tools with the technical information that helps exploration teams understand what matters.</p></div><div class="cards"><a href="/software" class="card"><span>01</span><div class="icon">⌁</div><h3>PyOrex Software</h3><p data-i18n="homeSoftDesc">Data analysis, diagrams, lithogeochemistry and mineral exploration workflows.</p><b>Explore software →</b></a><a href="/hub" class="card hubcard"><span>02</span><div class="icon">◈</div><h3>PyOrex HUB</h3><p data-i18n="homeHubDesc">Discoveries, papers, methods and technical intelligence — filtered for exploration.</p><b>Enter the HUB →</b></a></div></div></section>

<section class="founder">
  <div class="wrap founder-grid">
    <div class="founder-visual" aria-hidden="true">
      <div class="founder-icon">
        <svg viewBox="0 0 220 220" role="img" aria-label="Abstract exploration geologist with laptop">
          <defs>
            <linearGradient id="founderStroke" x1="30" y1="20" x2="190" y2="195" gradientUnits="userSpaceOnUse">
              <stop stop-color="#E5B84B"/>
              <stop offset=".34" stop-color="#74D9D8"/>
              <stop offset="1" stop-color="#1FCAD3"/>
            </linearGradient>
          </defs>
          <path d="M31 82C46 43 78 24 116 27c37 3 66 26 77 58" fill="none" stroke="#29454D" stroke-width="1.5"/>
          <path d="M23 108c7-38 33-69 69-82 41-14 84-1 107 33" fill="none" stroke="#19373F" stroke-width="1.2"/>
          <path d="M40 146c-11-46 13-92 56-111 40-17 86-4 111 31" fill="none" stroke="#183139" stroke-width="1.1"/>
          <circle cx="109" cy="76" r="20" fill="none" stroke="url(#founderStroke)" stroke-width="4.5"/>
          <path d="M73 137c5-27 18-42 36-42s31 15 36 42" fill="none" stroke="url(#founderStroke)" stroke-width="4.5" stroke-linecap="round"/>
          <path d="M56 130h106l-10 45H66z" fill="#091A20" stroke="url(#founderStroke)" stroke-width="3.5" stroke-linejoin="round"/>
          <path d="M47 177h124" stroke="url(#founderStroke)" stroke-width="4" stroke-linecap="round"/>
          <path d="M101 151h16" stroke="#E5B84B" stroke-width="3" stroke-linecap="round"/>
          <circle cx="43" cy="60" r="3" fill="#E5B84B"/>
          <circle cx="181" cy="113" r="3" fill="#1FCAD3"/>
          <path d="M43 60 71 49M181 113l-23 10" stroke="#33525A" stroke-width="1.2"/>
        </svg>
      </div>
    </div>
    <div class="founder-copy">
      <div class="eyebrow" data-i18n="founderEye">ABOUT THE FOUNDER</div>
      <h2>Brayan J. Castillo</h2>
      <p class="founder-role" data-i18n="founderRole">Exploration Geologist · Geochemistry · AI Builder</p>
      <p class="founder-desc" data-i18n="founderDesc">Exploration geologist focused on integrating geological reasoning, geochemistry and modern data workflows for mineral exploration. PyOrex was created to make advanced exploration methods more accessible, reproducible and practical for working geoscientists.</p>
      <div class="founder-actions">
        <a class="founder-btn primary" href="https://www.linkedin.com/in/brayancastillo/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="founder-btn" href="https://www.researchgate.net/profile/Brayan-Castillo-9" target="_blank" rel="noopener noreferrer">ResearchGate ↗</a>
      </div>
    </div>
  </div>
</section>
<section class="statement"><div class="wrap"><small data-i18n="homeBuilt">BUILT FOR EXPLORATION GEOSCIENTISTS</small><h2><span data-i18n="homeLess">Less friction.</span><br/><span data-i18n="homeBetter">Better geological decisions.</span></h2></div></section>
</Base>
<style>
.homehero{min-height:650px;background:radial-gradient(circle at 76% 40%,#19333b 0,#0b1c22 28%,#061216 63%);position:relative;overflow:hidden}.homegrid{min-height:650px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:30px}.homehero h1{font-size:clamp(58px,6vw,92px);line-height:.91;letter-spacing:-.06em;margin:22px 0}.homehero h1 span{font-weight:250;color:#b4c0c2}.homehero p{max-width:650px;color:#b7c2c4;font-size:18px;line-height:1.65}.actions{display:flex;gap:12px;margin-top:30px}.signals{display:flex;gap:26px;margin-top:70px;font-size:9px;letter-spacing:.14em;color:#6f8288}.visual{height:500px;position:relative}.orb{position:absolute;width:370px;height:370px;border:1px solid #37515a;border-radius:50%;top:55px;left:80px;box-shadow:0 0 100px rgba(229,184,75,.05),inset 0 0 80px rgba(56,104,118,.08)}.orb:before,.orb:after{content:"";position:absolute;border:1px solid #263d45;border-radius:50%;inset:50px}.orb:after{inset:110px;border-color:#7b672f}.trace{position:absolute;height:1px;width:520px;background:linear-gradient(90deg,transparent,#e5b84b,transparent);transform:rotate(-35deg);top:260px;left:0;opacity:.45}.t2{transform:rotate(28deg);background:linear-gradient(90deg,transparent,#5f8591,transparent);top:230px}.float{position:absolute;background:rgba(7,18,22,.86);border:1px solid #30454d;padding:16px 19px;min-width:210px;backdrop-filter:blur(8px)}.float small{display:block;color:var(--gold);font-size:8px;letter-spacing:.12em;margin-bottom:7px}.float b{font-size:14px}.f1{top:100px;right:0}.f2{bottom:80px;left:20px}.ecosystem{background:#0a181d;padding:85px 0}.intro{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-bottom:38px}.intro h2{font-size:48px;letter-spacing:-.045em;margin:13px 0 0}.intro p{color:var(--muted);line-height:1.65;max-width:570px}.cards{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{min-height:320px;padding:32px;border:1px solid var(--line);background:#0d2026;position:relative;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#5b7077}.card>span{color:#6e7d82;font-size:11px}.card .icon{font-size:44px;color:var(--gold);margin:40px 0 25px}.card h3{font-size:30px;margin:0 0 12px}.card p{color:var(--muted);line-height:1.6;max-width:500px}.card b{position:absolute;bottom:30px;font-size:12px}.hubcard{background:linear-gradient(135deg,#11262d,#0b1a20)}.statement{padding:100px 0;background:#e8e5dc;color:#111}.statement small{font-size:10px;letter-spacing:.15em}.statement h2{font-size:clamp(48px,6vw,82px);line-height:.95;letter-spacing:-.055em;margin:22px 0 0;font-weight:500}@media(max-width:900px){.homegrid,.intro,.cards{grid-template-columns:1fr}.visual{display:none}.homegrid{min-height:600px}.signals{flex-wrap:wrap}.ecosystem{padding:60px 0}}
.founder{padding:90px 0;background:#08161b;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.founder-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:64px;align-items:center}.founder-visual{display:flex;justify-content:center}.founder-icon{width:min(340px,84%);aspect-ratio:1;display:grid;place-items:center;background:radial-gradient(circle at 50% 46%,rgba(31,202,211,.08),rgba(8,22,27,0) 68%);position:relative}.founder-icon:before{content:"";position:absolute;inset:9%;border:1px solid rgba(70,112,122,.32);border-radius:50%;box-shadow:0 0 70px rgba(31,202,211,.035)}.founder-icon svg{width:84%;height:84%;filter:drop-shadow(0 0 16px rgba(31,202,211,.07))}.founder-copy h2{font-size:clamp(46px,5vw,74px);line-height:.96;letter-spacing:-.05em;margin:15px 0 14px}.founder-role{color:#31d7df;font-size:17px;margin:0 0 20px}.founder-desc{max-width:760px;color:#b7c2c4;font-size:17px;line-height:1.7}.founder-actions{display:flex;gap:12px;margin-top:28px}.founder-btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border:1px solid #25cad3;border-radius:4px;color:#34dbe3;font-size:14px;font-weight:600}.founder-btn.primary{background:#22d3dc;color:#041317}.founder-btn:hover{transform:translateY(-1px)}@media(max-width:900px){.founder{padding:64px 0}.founder-grid{grid-template-columns:1fr;gap:34px}.founder-visual{justify-content:flex-start}.founder-icon{width:190px}.founder-actions{flex-wrap:wrap}}
</style>