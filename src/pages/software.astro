---
import Base from '../layouts/Base.astro';
---
<Base title="PyOrex Software — Coming Soon" description="PyOrex Software is under active development.">
<section class="soon"><div class="wrap"><div class="eyebrow">PYOREX SOFTWARE · IN DEVELOPMENT</div><div class="badge">COMING SOON</div><h1>Built for<br/><span>exploration.</span></h1><p>A new geoscience workspace for mineral exploration is under active development.</p><div class="line"></div><div class="note"><b>Focused. Geological. Practical.</b><span>More will be revealed when it is ready.</span></div><a class="btn gold" href="/hub">Explore PyOrex HUB →</a></div></section>
</Base>
<style>.soon{min-height:760px;display:flex;align-items:center;background:radial-gradient(circle at 78% 28%,#1b3941 0,#0b2026 27%,#061216 62%);overflow:hidden}.soon .wrap{padding-top:70px;padding-bottom:90px}.badge{display:inline-block;margin-top:38px;border:1px solid var(--gold);color:var(--gold);font-size:10px;letter-spacing:.2em;padding:9px 12px}.soon h1{font-size:clamp(72px,9vw,132px);line-height:.8;letter-spacing:-.07em;margin:30px 0}.soon h1 span{font-weight:250;color:#aebabc}.soon p{font-size:20px;line-height:1.6;color:#b7c2c4;max-width:650px}.line{height:1px;background:var(--line);max-width:650px;margin:38px 0 25px}.note{display:flex;flex-direction:column;gap:7px;margin-bottom:32px}.note b{font-size:13px}.note span{font-size:11px;color:var(--muted)}</style>