em}.modicon{font-size:46px;color:#2dd1d7;margin:32px 0 18px}.module h3{font-size:32px;margin:0 0 12px}.module>p{color:#aebdc1;line-height:1.65;min-height:54px}.upload{display:flex;justify-content:space-between;align-items:center;border:1px solid #31505a;padding:15px 16px;cursor:pointer;margin-top:28px}.upload:hover{border-color:#55cbd0}.upload input{display:none}.upload b{font-size:12px}.upload span{font-size:10px;color:#71858a}.status{margin-top:14px;color:#6f858b;font-size:11px}.processor{margin-top:34px;border:1px solid #29454d;background:#0a1a20}.processor-head{display:flex;justify-content:space-between;gap:30px;align-items:flex-end;padding:28px;border-bottom:1px solid #223b43}.processor-head h2{font-size:28px;margin:8px 0 0}.processor-actions{display:flex;gap:10px;flex-wrap:wrap}.processor-actions select,.processor-actions button,.charthead select,.spectral-controls input{background:#08161b;border:1px solid #31505a;color:#b9c6c9;padding:10px 12px}.processor-actions button{cursor:pointer}.metrics{display:grid;grid-template-columns:1.2fr repeat(4,1fr);gap:1px;background:#20373e}.metrics div{background:#0b1d23;padding:18px 22px}.metrics small{display:block;font-size:8px;color:#71858a;margin-bottom:8px}.metrics b{font-size:16px;overflow-wrap:anywhere}.tabs{display:flex;gap:0;border-bottom:1px solid #223b43;padding:0 22px}.tooltab{background:none;border:0;border-bottom:2px solid transparent;color:#74898f;padding:16px 17px;cursor:pointer}.tooltab.active{color:#e5e9ea;border-bottom-color:var(--gold)}.toolpanel{padding:24px}.fieldblock>small{font-size:9px;color:var(--gold);letter-spacing:.15em}.fieldblock #field-tags,.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.fieldblock span,.chips span{border:1px solid #29464f;padding:7px 10px;font-size:10px;color:#9aadb1}.tablewrap{overflow:auto;margin-top:20px;border:1px solid #203940}.tablewrap table{border-collapse:collapse;width:100%;font-size:11px}.tablewrap th{position:sticky;top:0;background:#10252b;color:#9fb