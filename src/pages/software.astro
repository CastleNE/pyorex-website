---
import Base from '../layouts/Base.astro';
---
<Base title="PyOrex Software"><section class="software-hero"><div class="wrap"><div class="eyebrow">PyOrex Software</div><h1 class="display">Geoscience tools.<br/>Without the friction.</h1><p class="lead">An open desktop toolkit for geological data analysis, visualization, lithogeochemistry and mineral exploration workflows.</p><div class="actions"><a class="btn yellow" href="https://github.com/ctarazonas/pyorex-desktop/releases">Download latest release</a><a class="btn" href="https://github.com/ctarazonas/pyorex-desktop">View on GitHub</a></div></div></section><section class="section"><div class="wrap"><div class="eyebrow">What you can do</div><h2 class="section-title">Built around exploration workflows</h2><div class="grid">{['Data Analysis','Diagrams','Lithogeochemistry','Mineral Exploration'].map((x,i)=><article class="card module"><small>0{i+1}</small><h3>{x}</h3><p>{['Explore and understand geological datasets with practical statistical tools.','Create publication-ready geological and statistical visualizations.','Classify, normalize and interpret whole-rock geochemical data.','Bring geological evidence together for practical exploration decisions.'][i]}</p></article>)}</div></div></section><section class="section support"><div class="wrap"><div class="eyebrow">Open project</div><h2>Help PyOrex grow.</h2><p>Use it, test it, contribute code, report issues or support continued development.</p><a class="btn primary" href="/support">Support PyOrex →</a></div></section></Base>
<style>.software-hero{padding:110px 0;background:#171717;color:#fff}.software-hero .lead{color:#bbb}.actions{margin-top:35px}.software-hero .btn:not(.yellow){color:#fff;border-color:#777}.module{grid-column:span 3;min-height:240px}.module small{font-weight:800;color:#999}.support{background:var(--yellow)}.support h2{font-size:55px;letter-spacing:-.04em;margin:12px 0}.support p{font-size:20px;max-width:620px}@media(max-width:900px){.module{margin-bottom:14px}}</style>