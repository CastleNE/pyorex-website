---
import Base from '../layouts/Base.astro';
---
<Base title="PyOrex Software"><section class="software-hero"><div class="wrap"><div class="eyebrow">PyOrex Software</div><h1 class="display"><span data-i18n="softHero1">Geoscience tools.</span><br/><span data-i18n="softHero2">Without the friction.</span></h1><p class="lead" data-i18n="softLead">An open desktop toolkit for geological data analysis, visualization, lithogeochemistry and mineral exploration workflows.</p><div class="actions"><a class="btn yellow" href="https://github.com/ctarazonas/pyorex-desktop/releases" data-i18n="download">Download latest release</a><a class="btn" href="https://github.com/ctarazonas/pyorex-desktop" data-i18n="viewGithub">View on GitHub</a></div></div></section><section class="section"><div class="wrap"><div class="eyebrow" data-i18n="canDo">What you can do</div><h2 class="section-title" data-i18n="workflows">Built around exploration workflows</h2><div class="grid">{[['m1','m1d','Data Analysis','Explore and understand geological datasets with practical statistical tools.'],['m2','m2d','Diagrams','Create publication-ready geological and statistical visualizations.'],['m3','m3d','Lithogeochemistry','Classify, normalize and interpret whole-rock geochemical data.'],['m4','m4d','Mineral Exploration','Bring geological evidence together for practical exploration decisions.']].map((x,i)=><article class="card module"><small>0{i+1}</small><h3 data-i18n={x[0]}>{x[2]}</h3><p data-i18n={x[1]}>{x[3]}</p></article>)}</div></div></section><section class="section support"><div class="wrap"><div class="eyebrow" data-i18n="openProject">Open project</div><h2 data-i18n="helpGrow">Help PyOrex grow.</h2><p data-i18n="helpDesc">Use it, test it, contribute code, report issues or support continued development.</p><a class="btn primary" href="/support" data-i18n="supportPy">Support PyOrex →</a></div></section></Base>
<style>.software-hero{padding:110px 0;background:#171717;color:#fff}.software-hero .lead{color:#bbb}.actions{margin-top:35px}.software-hero .btn:not(.yellow){color:#fff;border-color:#777}.module{grid-column:span 3;min-height:240px}.module small{font-weight:800;color:#999}.support{background:var(--yellow)}.support h2{font-size:55px;letter-spacing:-.04em;margin:12px 0}.support p{font-size:20px;max-width:620px}@media(max-width:900px){.module{margin-bottom:14px}}</style>