e-height:1.5;color:#d9e0e1;border-left:2px solid var(--gold);padding-left:18px}.askcard p{color:#98aaae;line-height:1.7}.askcard button{width:100%;padding:13px;border:1px solid #35515a;background:#0a181d;color:#71858a}.desktop{padding:85px 0;background:#e8e5dc;color:#111}.desktop p{color:#4c5558}@media(max-width:1000px){.hero-grid,.section-head,.modules,.ask-grid,.desk-grid,.chartgrid{grid-template-columns:1fr}.hero{min-height:auto}.hero-grid{padding:70px 0}.flowcard{display:none}.metrics{grid-template-columns:1fr 1fr}.processor-head,.spectral-controls{align-items:flex-start;flex-direction:column}.workspace,.ask,.desktop{padding:60px 0}}@media(max-width:620px){.metrics{grid-template-columns:1fr}.actions{flex-wrap:wrap}.tabs{overflow:auto}.local{align-items:flex-start;flex-wrap:wrap}}
