---
import Base from '../layouts/Base.astro';
const metals=[['Au','3,682.40','USD/oz','+0.62%'],['Ag','44.15','USD/oz','+1.20%'],['Cu','4.28','USD/lb','+0.47%'],['Mo','21.85','USD/lb','−0.23%'],['Zn','1.30','USD/lb','+0.31%'],['Pb','0.98','USD/lb','+0.10%']];
const channels=[['▧','News & Insights','Exploration news, market trends and analysis','/hub/news'],['⚒','New Discoveries','Significant discoveries worldwide','/hub/discoveries'],['▤','Exploration Methods','Practical guides and technical notes','/hub/methods'],['◉','Research & Papers','Curated scientific literature','/hub/research'],['△','Andes & Peru','Andean geology and opportunities','/hub/andes']];
---
<Base title="PyOrex HUB — Exploration Intelligence">
<section class="ticker"><div class="wrap metals">{metals.map((m,i)=><div class="metal"><b>{m[0]}</b><div><strong>{m[1]}</strong><small>{m[2]}</small></div><em class={i===3?'down':''}>{m[3]}</em></div>)}<div class="source"><small>MARKET WATCH</small><span>Prices module · beta</span></div></div></section>
<section class="hero"><div class="shade"></div><div class="wrap hero-grid"><div class="hero-copy"><div class="eyebrow">— &nbsp; PYOREX HUB</div><h1>Exploration<br/><span>intelligence</span></h1><div class="next">for what’s next.</div><p>News, discoveries, methods and technical analysis for mineral exploration and economic geology.</p><div class="actions"><a class="btn gold" href="#explore">Explore the HUB →</a><a class="btn" href="/software">Learn about PyOrex</a></div><div class="geo"><span>THE ANDES AND BEYOND</span><small>PEOPLE / DATA / IDEAS / DISCOVERY</small></div></div>
<aside><div class="aside-head"><h2>Latest in Exploration</h2><a href="#explore">View all →</a></div><a class="story" href="/hub/discoveries"><article><span>NEW DISCOVERY</span><small>Explore →</small><h3>New discoveries and drilling results worth understanding</h3></article></a><a class="story" href="/hub/research"><article><span>RESEARCH</span><small>Weekly</small><h3>Structural controls, geochemistry and mineral systems</h3></article></a><a class="story" href="/hub/methods"><article><span>METHODS</span><small>Weekly</small><h3>Practical exploration workflows and emerging methods</h3></article></a><a class="story" href="/hub/andes"><article><span>ANDES</span><small>Regional</small><h3>Technical intelligence from Peru and the Andes</h3></article></a></aside></div></section>
<section id="explore" class="channels"><div class="wrap channel-grid">{channels.map(c=><a class="channel" href={c[3]}><i>{c[0]}</i><div><strong>{c[1]}</strong><p>{c[2]}</p></div><b>→</b></a>)}</div></section>
<section class="software"><div class="wrap software-grid"><div><div class="eyebrow">PYOREX SOFTWARE</div><h2>Geochemical tools<br/>for real exploration.</h2><p>Analyse, visualise and interpret geological data with tools built around exploration workflows.</p><div class="actions"><a class="btn gold" href="/software">Learn more →</a><a class="btn" href="https://github.com/ctarazonas/pyorex-desktop">View GitHub</a></div></div><div class="app"><div class="appbar">● ○ ○ <span>TAS &nbsp;&nbsp; QAPF &nbsp;&nbsp; AFM &nbsp;&nbsp; REE &nbsp;&nbsp; Spider &nbsp;&nbsp; QAQC</span></div><div class="plot"><div class="axis y"></div><div class="axis x"></div><div class="curve"></div>{Array.from({length:22}).map((_,i)=><i style={`left:${14+(i*3.2)%72}%;bottom:${18+(i*13)%48}%`}></i>)}</div></div><blockquote>“Better information<br/>for better discoveries.”<small>— PyOrex</small></blockquote></div></section>
</Base>
<style>
.ticker{background:#050d10;border-bottom:1px solid var(--line)}.metals{height:68px;display:flex;align-items:stretch}.metal{min-width:155px;flex:1;display:flex;align-items:center;gap:12px;border-right:1px solid var(--line);padding:9px 15px}.metal>b{font-size:20px}.metal strong{display:block;font-size:14px}.metal small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.metal em{font-style:normal;color:#49d979;font-size:12px;margin-left:auto}.metal em.down{color:#ff6262}.source{width:160px;display:flex;justify-content:center;flex-direction:column;padding-left:18px;color:var(--muted)}.source span,.source small{font-size:9px}.hero{min-height:520px;position:relative;background:radial-gradient(circle at 56% 20%,#36515a 0,#142b34 25%,#08171d 55%,#061014 100%);overflow:hidden}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,transparent 0 52%,rgba(229,184,75,.09) 52.2%,transparent 52.7%),linear-gradient(25deg,transparent 0 63%,rgba(255,255,255,.04) 63.2%,transparent 63.7%);opacity:.8}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,2.1fr) minmax(350px,.9fr);gap:42px;padding-top:55px;padding-bottom:36px}.hero-copy h1{font-size:clamp(52px,5vw,78px);line-height:.88;letter-spacing:-.055em;margin:24px 0 10px}.hero-copy h1 span{font-weight:300}.next{font-size:45px;font-weight:250;color:#aeb9bc;letter-spacing:-.04em}.hero-copy>p{font-size:18px;line-height:1.5;max-width:600px;color:#d1d7d7}.actions{display:flex;gap:12px;margin-top:26px}.geo{margin-top:55px;display:flex;flex-direction:column;font-size:10px;letter-spacing:.12em}.geo small{color:var(--muted);margin-top:7px}aside{background:rgba(6,18,23,.88);border:1px solid #35474e;border-radius:10px;padding:20px 22px;backdrop-filter:blur(12px)}.aside-head{display:flex;align-items:center;justify-content:space-between}.aside-head h2{font-size:18px}.aside-head a{font-size:11px;color:var(--muted)}aside article{padding:13px 0;border-top:1px solid var(--line)}aside article span{font-size:9px;background:#334249;border-radius:3px;padding:3px 6px}aside article:first-of-type span{background:#9b7624}aside article small{float:right;color:var(--muted);font-size:10px}aside article h3{font-size:14px;line-height:1.35;margin:9px 0 0}.channels{background:#09171c;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.channel-grid{display:grid;grid-template-columns:repeat(5,1fr)}.channel{min-height:108px;padding:23px 20px;display:flex;gap:16px;align-items:center;border-right:1px solid var(--line)}.channel:first-child{border-left:1px solid var(--line)}.channel i{font-size:26px;font-style:normal}.channel strong{font-size:13px}.channel p{font-size:10px;line-height:1.5;color:var(--muted);margin:7px 0 0}.channel>b{margin-left:auto;font-weight:400}.software{padding:55px 0;background:linear-gradient(120deg,#071216,#09191e)}.software-grid{display:grid;grid-template-columns:.8fr 1.3fr .8fr;gap:38px;align-items:center}.software h2{font-size:31px;line-height:1.15;font-weight:450}.software p{color:var(--muted);line-height:1.6;font-size:13px}.app{height:240px;background:#0b1a20;border:1px solid #2c3e45;border-radius:9px;overflow:hidden}.appbar{height:42px;border-bottom:1px solid var(--line);padding:14px;font-size:9px;color:#75878d}.appbar span{float:right}.plot{position:relative;height:180px;margin:10px 28px}.axis{position:absolute;background:#52656c}.axis.x{height:1px;bottom:25px;left:35px;right:15px}.axis.y{width:1px;left:35px;top:15px;bottom:25px}.plot i{position:absolute;width:5px;height:5px;background:var(--gold);border-radius:50%}.curve{position:absolute;left:60px;bottom:40px;width:70%;height:70px;border-bottom:1px solid #6b8b99;transform:skewY(-9deg)}blockquote{font-size:24px;font-style:italic;line-height:1.35;margin:0;color:#ddd}blockquote small{display:block;font-size:12px;font-style:normal;color:var(--muted);margin-top:12px}@media(max-width:1000px){.metals{overflow:auto}.source{display:none}.hero-grid,.software-grid{grid-template-columns:1fr}.channel-grid{grid-template-columns:1fr 1fr}.hero-grid aside{margin-bottom:20px}}@media(max-width:620px){.channel-grid{grid-template-columns:1fr}.next{font-size:35px}.hero-grid{padding-top:40px}.metal{min-width:140px}}
</style>