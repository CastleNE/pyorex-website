---
import Base from '../layouts/Base.astro';
const topics=['Andes & Peru','Gold Exploration','Copper Exploration','Structural Geology','Lithogeochemistry','Porphyry','Epithermal','IRGS','VMS','Geophysics & Remote Sensing'];
---
<Base title="PyOrex HUB — Exploration Intelligence"><section class="hubhero"><div class="wrap"><div class="eyebrow">PyOrex HUB · Exploration Intelligence</div><h1>Signal over noise.</h1><p>Worthwhile discoveries, research, methods and technical analysis for mineral exploration and economic geology.</p></div></section><section class="section latest"><div class="wrap"><div class="bar"><span class="eyebrow">Featured</span><span>Curated for exploration geoscientists</span></div><article class="feature"><div><span class="tag">Weekly Exploration Brief</span><h2>The things worth reading in mineral exploration this week.</h2><p>A concise technical filter across new discoveries, structural controls, lithogeochemistry, intrusive-related systems and the Andes.</p><a href="#">Coming soon →</a></div><div class="geo">Au<br/><span>79</span></div></article></div></section><section class="section"><div class="wrap"><div class="eyebrow">Explore the HUB</div><h2 class="section-title">Follow the geology, not the algorithm.</h2><div class="grid"><article class="card feed"><h3>Discoveries</h3><p>New mineral discoveries, drilling results and exploration stories worth understanding.</p></article><article class="card feed"><h3>Papers & Reports</h3><p>Peer-reviewed research, SEG/SGA/AusIMM material and technical reports with exploration relevance.</p></article><article class="card feed"><h3>Methods</h3><p>Emerging and proven exploration methods, workflows and practical applications.</p></article></div><div class="topics">{topics.map(t=><a href="#">{t}</a>)}</div></div></section></Base>
<style>.hubhero{background:var(--hub);color:#fff;padding:105px 0 90px}.hubhero .eyebrow{color:#b7c4bb}.hubhero h1{font-family:Georgia,serif;font-size:clamp(65px,9vw,120px);font-weight:400;letter-spacing:-.055em;margin:20px 0 10px}.hubhero p{font-family:Georgia,serif;font-size:25px;line-height:1.5;color:#d4dbd6;max-width:750px}.latest{background:#e8ebe7}.bar{display:flex;justify-content:space-between;border-bottom:1px solid #9da79f;padding-bottom:14px;color:#5c685f}.feature{padding:48px 0;display:grid;grid-template-columns:2fr 1fr;gap:50px}.feature h2{font-family:Georgia,serif;font-size:48px;line-height:1.05;font-weight:400;margin:16px 0}.feature p{font-size:18px;line-height:1.6;color:#59635c;max-width:720px}.feature a{font-weight:800}.tag{font-size:12px;text-transform:uppercase;letter-spacing:.12em}.geo{width:190px;height:190px;border:1px solid #6b776e;display:flex;flex-direction:column;align-items:center;justify-content:center;font:70px Georgia,serif;margin:auto}.geo span{font:14px sans-serif}.feed{grid-column:span 4}.topics{display:flex;flex-wrap:wrap;gap:9px;margin-top:35px}.topics a{padding:10px 14px;border:1px solid #aaa;background:#fff;font-size:13px;font-weight:700}@media(max-width:760px){.feature{display:block}.geo{margin:30px 0}.feed{margin-bottom:14px}}</style>