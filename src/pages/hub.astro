---
import Base from '../layouts/Base.astro';
import data from '../data/opportunities.json';
import majors from '../data/major-signals.json';
const items=data.items;
const priorityCount=items.filter(x=>(x.opportunity_rating||"").includes("HIGH")||(x.opportunity_rating||"").includes("TOP")).length;
const slug=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
---
<Base title="PyOrex HUB — New Opportunities">
<section class="ticker"><div class="wrap metals"><div class="metal" data-metal="Au"><b>Au</b><div><strong>—</strong><small>USD/oz</small></div><em data-en="LIVE" data-es="EN VIVO">LIVE</em></div><div class="metal" data-metal="Ag"><b>Ag</b><div><strong>—</strong><small>USD/oz</small></div><em data-en="LIVE" data-es="EN VIVO">LIVE</em></div><div class="metal" data-metal="Cu"><b>Cu</b><div><strong>—</strong><small>USD/lb</small></div><em data-en="LIVE" data-es="EN VIVO">LIVE</em></div><div class="metal" data-metal="Zn"><b>Zn</b><div><strong>—</strong><small>USD/lb</small></div><em data-en="LIVE" data-es="EN VIVO">LIVE</em></div><div class="metal" data-metal="Pb"><b>Pb</b><div><strong>—</strong><small>USD/lb</small></div><em data-en="LIVE" data-es="EN VIVO">LIVE</em></div><div class="market-source"><small data-en="MARKET WATCH" data-es="MERCADO">MARKET WATCH</small><span id="market-status" data-en="Loading live prices…" data-es="Cargando precios en vivo…">Loading live prices…</span></div></div></section><section class="hub">
 <div class="wrap">
  <div class="eyebrow" data-i18n="hubEye">PYOREX HUB · NEW OPPORTUNITIES</div>
  <div class="intro"><div><h1 data-i18n="hubTitle">Find the next opportunity.</h1><p data-i18n="hubLead">A focused scouting screen of junior-controlled Peruvian projects, transactions and strategic watchlist assets. Availability is reported only when supported by a public source.</p></div><a class="archive-link" href="/hub/archive" data-i18n="hubArchive">HISTORICAL ARCHIVE →</a></div>
  <div class="command-strip"><div><small data-en="MONITORED PROJECTS" data-es="PROYECTOS MONITOREADOS">MONITORED PROJECTS</small><strong>{items.length}</strong></div><div><small data-en="HIGH-PRIORITY SIGNALS" data-es="SEÑALES DE ALTA PRIORIDAD">HIGH-PRIORITY SIGNALS</small><strong>{priorityCount}</strong></div><div><small data-en="MAJOR SIGNALS" data-es="SEÑALES DE MAJORS">MAJOR SIGNALS</small><strong>{majors.items.length}</strong></div><div><small data-en="INTELLIGENCE STATUS" data-es="ESTADO DE INTELIGENCIA">INTELLIGENCE STATUS</small><strong id="intelligence-status" class="live-dot" data-en="CHECKING" data-es="VERIFICANDO">CHECKING</strong><small id="intel-review-count" class="intel-review-count"></small></div></div><section class="latest-intelligence" aria-labelledby="latest-heading"><div class="latest-heading"><div><small data-en="INTELLIGENCE ARCHIVE · LATEST RECORDS" data-es="ARCHIVO DE INTELIGENCIA · ÚLTIMOS REGISTROS">INTELLIGENCE ARCHIVE · LATEST RECORDS</small><h2 id="latest-heading" data-en="Recent project activity" data-es="Actividad reciente de proyectos">Recent project activity</h2></div><a href="/hub/archive" data-en="EXPLORE FULL ARCHIVE →" data-es="EXPLORAR ARCHIVO COMPLETO →">EXPLORE FULL ARCHIVE →</a></div><div id="latest-feed" class="latest-feed"><p data-en="Loading verified archive records…" data-es="Cargando registros del archivo…">Loading verified archive records…</p></div><div id="latest-meta" class="latest-meta"></div></section>
  <div class="section-kicker"><span data-en="OPPORTUNITY RADAR" data-es="RADAR DE OPORTUNIDADES">OPPORTUNITY RADAR</span><span data-en="TECHNICAL + CORPORATE SCREENING" data-es="EVALUACIÓN TÉCNICA + CORPORATIVA">TECHNICAL + CORPORATE SCREENING</span></div><div class="search"><span>⌕</span><input id="q" placeholder="Search company, project, region, commodity..." data-i18n-placeholder="hubSearch"/></div>
  <div class="follow-toolbar"><button id="following-only" type="button" aria-pressed="false">☆ <span data-en="FOLLOWING" data-es="SIGUIENDO">FOLLOWING</span> <span id="following-count">0</span></button><small data-en="Saved in this browser · no alerts yet" data-es="Guardado en este navegador · aún sin alertas">Saved in this browser · no alerts yet</small></div><div class="filters">
   <select id="commodity"><option value="" data-en="COMMODITY · ALL" data-es="COMMODITY · TODOS">COMMODITY · ALL</option><option>Au</option><option>Ag</option><option>Cu</option><option>Zn</option><option>Pb</option></select>
   <select id="region"><option value="" data-en="REGION · ALL" data-es="REGIÓN · TODAS">REGION · ALL</option><option value="North" data-en="North" data-es="Norte">North</option><option value="Central" data-en="Central" data-es="Centro">Central</option><option value="South" data-en="South" data-es="Sur">South</option></select>
   <select id="stage"><option value="" data-en="STAGE · ALL" data-es="ETAPA · TODAS">STAGE · ALL</option><option value="Early-stage" data-en="Early-stage" data-es="Etapa temprana">Early-stage</option><option value="Exploration" data-en="Exploration" data-es="Exploración">Exploration</option><option value="Resource" data-en="Resource" data-es="Recursos">Resource</option><option value="Advanced" data-en="Advanced" data-es="Avanzado">Advanced</option></select>
   <select id="deal"><option value="" data-en="DEAL · ALL" data-es="ACUERDO · TODOS">DEAL · ALL</option><option>JV</option><option value="Option" data-en="Option" data-es="Opción">Option</option><option value="Acquisition" data-en="Acquisition" data-es="Adquisición">Acquisition</option><option value="Strategic watch" data-en="Strategic watch" data-es="Seguimiento estratégico">Strategic watch</option></select>
  </div>
  <div class="meta"><span id="count">{items.length} OPPORTUNITIES</span><span data-en="MONITORED UNIVERSE · PUBLIC SOURCES · REVIEWED 2026-10-04" data-es="UNIVERSO MONITOREADO · FUENTES PÚBLICAS · REVISADO 2026-10-04">MONITORED UNIVERSE · PUBLIC SOURCES · REVIEWED 2026-10-04</span></div>
  <div id="list" class="list">
   {items.map(x=><article class="card" data-project={slug(x.project)} data-search={(x.company+" "+x.project+" "+x.region+" "+x.country+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage+" "+(x.association_type||"")+" "+(x.opportunity_rating||"")).toLowerCase()} data-commodities={x.commodities.join(" ")} data-region={(x.macro_region||"").toLowerCase()} data-stage={x.stage.toLowerCase()} data-deal={(x.association_type||"").toLowerCase()}>
    <div class="identity"><small>{x.company}</small><h2><a href={`/hub/project/${slug(x.project)}`}>{x.project}</a></h2><span>{x.region} · {x.country}</span><div class="chips">{x.commodities.map(v=><i>{v}</i>)}</div></div>
    <div class="assessment"><small data-en="PYOREX SCREENING" data-es="EVALUACIÓN PYOREX">PYOREX SCREENING</small><strong data-content-en={x.opportunity_rating||x.opportunity_type} data-content-es={x.opportunity_rating_es||x.opportunity_rating||x.opportunity_type}>{x.opportunity_rating||x.opportunity_type}</strong><p data-content-en={x.why_it_matters} data-content-es={x.why_it_matters_es||x.why_it_matters}>{x.why_it_matters}</p></div>
    <div class="facts"><div><small data-en="DEPOSIT STYLE" data-es="ESTILO DE DEPÓSITO">DEPOSIT STYLE</small><b data-content-en={x.deposit_model} data-content-es={x.deposit_model_es||x.deposit_model}>{x.deposit_model}</b></div><div><small data-en="STAGE" data-es="ETAPA">STAGE</small><b data-value={x.stage}>{x.stage}</b></div><div><small data-en="ASSOCIATION" data-es="ASOCIACIÓN">ASSOCIATION</small><b data-value={x.association_type||"Strategic watch"}>{x.association_type||"Strategic watch"}</b></div><div><small data-en="AVAILABILITY" data-es="DISPONIBILIDAD">AVAILABILITY</small><b data-content-en={x.availability_status||"Not publicly marketed"} data-content-es={x.availability_status_es||x.availability_status||"Not publicly marketed"}>{x.availability_status||"Not publicly marketed"}</b></div></div>
    <div class="actions"><button type="button" class="follow-project" data-follow={slug(x.project)} aria-pressed="false">☆ FOLLOW</button><a class="record" href={`/hub/project/${slug(x.project)}`} data-en="OPEN PROJECT →" data-es="ABRIR PROYECTO →">OPEN PROJECT →</a><a href={x.source_url} target="_blank" rel="noopener" data-en="PRIMARY SOURCE ↗" data-es="FUENTE PRIMARIA ↗">PRIMARY SOURCE ↗</a></div>
   </article>)}
  </div>
  <div id="empty" class="empty" data-i18n="hubEmpty">No opportunities match these filters.</div><div class="coverage"><b data-i18n="hubCoverage">COVERAGE</b><span data-i18n="hubCoverageText">PyOrex monitors a defined public-source universe of Peru-focused juniors, project generators, transactions and technically material discovery stories. It is continuously reviewed; it is not presented as an exhaustive registry of every mineral property in Peru.</span></div>
 </div>
</section>
<section class="majors"><div class="wrap"><div class="major-head"><div><div class="eyebrow" data-i18n="majorEye">MAJOR COMPANY SIGNALS</div><h2 data-i18n="majorTitle">Moves worth watching.</h2><p data-i18n="majorLead">Selected exploration programs, major–junior partnerships and transactions that may reshape opportunity flow.</p></div></div><div class="major-grid">{majors.items.map(x=><article><div class="major-meta"><span data-content-en={x.category} data-content-es={x.category_es||x.category}>{x.category}</span><time>{x.date}</time></div><small>{x.company} · {x.region}</small><h3 data-content-en={x.headline} data-content-es={x.headline_es||x.headline}>{x.headline}</h3><p data-content-en={x.signal} data-content-es={x.signal_es||x.signal}>{x.signal}</p><div class="major-why"><b data-en="WHY IT MATTERS" data-es="POR QUÉ IMPORTA">WHY IT MATTERS</b><span data-content-en={x.why_it_matters} data-content-es={x.why_it_matters_es||x.why_it_matters}>{x.why_it_matters}</span></div><a href={x.source_url} target="_blank" rel="noopener"><span data-en="PRIMARY SOURCE" data-es="FUENTE PRIMARIA">PRIMARY SOURCE</span> · {x.source_name} ↗</a></article>)}</div></div></section>
<script>
(async()=>{const status=document.getElementById("market-status");try{const r=await fetch("/api/metals"),d=await r.json();if(!r.ok||d.status!=="success")throw new Error();for(const [symbol,item] of Object.entries(d.metals)){const el=document.querySelector(`[data-metal="${symbol}"]`);if(!el)continue;const decimals=(symbol==="Au"||symbol==="Ag")?2:3;el.querySelector("strong").textContent=Number(item.price).toLocaleString("en-US",{minimumFractionDigits:decimals,maximumFractionDigits:decimals});el.querySelector("small").textContent=item.unit}status.textContent=(localStorage.getItem("pyorex-lang")==="es"?"Metals.Dev · en vivo":"Metals.Dev · live")}catch(e){status.textContent=(localStorage.getItem("pyorex-lang")==="es"?"Datos de mercado temporalmente no disponibles":"Market data temporarily unavailable")}})();
const q=document.getElementById("q"),commodity=document.getElementById("commodity"),region=document.getElementById("region"),stage=document.getElementById("stage"),deal=document.getElementById("deal"),cards=[...document.querySelectorAll(".card")],count=document.getElementById("count"),empty=document.getElementById("empty");
const followKey="pyorex-followed-projects-v1";let followed=[];try{const stored=JSON.parse(localStorage.getItem(followKey)||"[]");if(Array.isArray(stored))followed=stored.filter(x=>typeof x==="string")}catch(e){}const followSet=new Set(followed);let followingOnly=false;const followingButton=document.getElementById("following-only");function renderFollow(){document.getElementById("following-count").textContent=String(followSet.size);followingButton.setAttribute("aria-pressed",String(followingOnly));followingButton.classList.toggle("active",followingOnly);document.querySelectorAll(".follow-project").forEach(b=>{const active=followSet.has(b.dataset.follow);b.setAttribute("aria-pressed",String(active));b.textContent=(active?"★ ":"☆ ")+(lang()==="es"?(active?"SIGUIENDO":"SEGUIR"):(active?"FOLLOWING":"FOLLOW"));});}document.querySelectorAll(".follow-project").forEach(b=>b.addEventListener("click",()=>{const id=b.dataset.follow;if(followSet.has(id))followSet.delete(id);else followSet.add(id);try{localStorage.setItem(followKey,JSON.stringify([...followSet]))}catch(e){}renderFollow();filter()}));followingButton.addEventListener("click",()=>{followingOnly=!followingOnly;renderFollow();filter()});
const latestBox=document.getElementById("latest-feed"),latestMeta=document.getElementById("latest-meta"),intelStatus=document.getElementById("intelligence-status");let latestEvents=[],latestState="loading",scanStatus=null;const safe=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));function renderLatest(){const es=lang()==="es";if(latestState==="error"){latestBox.textContent=es?"No se pudo consultar el archivo histórico.":"Historical archive could not be loaded.";return}if(!latestEvents.length){latestBox.textContent=es?"Todavía no hay eventos disponibles en el archivo.":"No archive events are available yet.";return}latestBox.innerHTML=latestEvents.map(e=>{const title=es?(e.title_es||e.title):e.title;const summary=es?(e.summary_es||e.summary||e.why_it_matters_es||e.why_it_matters):(e.summary||e.why_it_matters);const url=e.project_slug?"/hub/project/"+encodeURIComponent(e.project_slug):"/hub/archive";return '<article><div class="feed-date">'+safe(e.event_date)+'</div><div><small>'+safe(e.company||e.source_name||"")+' · '+safe(e.event_type||"")+'</small><h3><a href="'+url+'">'+safe(e.project||title||"")+'</a></h3><p>'+safe(title||"")+'</p><div class="feed-summary">'+safe(summary||"")+'</div></div><a class="feed-source" href="'+safe(e.source_url||"/hub/archive")+'" target="_blank" rel="noopener noreferrer">'+(es?"FUENTE ↗":"SOURCE ↗")+'</a></article>'}).join("");latestMeta.textContent=es?"Últimos registros del archivo · ordenados por fecha del evento":"Latest archive records · sorted by event date"}function renderStatus(){const es=lang()==="es",review=document.getElementById("intel-review-count");if(!scanStatus||scanStatus.status!=="success"){intelStatus.textContent=es?"ESTADO NO DISPONIBLE":"STATUS UNAVAILABLE";review.textContent="";return}const run=scanStatus.last_scan;intelStatus.textContent=run?.finished_at?(es?"ÚLTIMO ESCANEO: ":"LAST SCAN: ")+String(run.finished_at).slice(0,10):(es?"SIN ESCANEOS CONFIRMADOS":"NO CONFIRMED SCANS");const n=Number(scanStatus.pending_candidates||0),high=Number(scanStatus.screening?.high||0);review.textContent=es?`${n} candidatos sin verificar · ${high} de alta prioridad`:`${n} unverified candidates · ${high} high priority`;}Promise.allSettled([fetch("/api/hub/events?limit=6").then(r=>{if(!r.ok)throw Error("archive");return r.json()}),fetch("/api/hub/status").then(r=>{if(!r.ok)throw Error("status");return r.json()})]).then(([events,status])=>{if(events.status==="fulfilled"&&events.value.status==="success"){latestEvents=events.value.items||[];latestState="ready"}else latestState="error";if(status.status==="fulfilled")scanStatus=status.value;renderLatest();renderStatus()});window.addEventListener("pyorex-language",()=>{renderLatest();renderStatus()});
const valueES={'early-stage':'Etapa temprana','exploration':'Exploración','resource':'Recursos','advanced':'Avanzado','strategic watch':'Seguimiento estratégico','option':'Opción','acquisition':'Adquisición','not publicly marketed':'No se comercializa públicamente'};
function lang(){return localStorage.getItem('pyorex-lang')||document.documentElement.lang||'en'}
function translateHub(){const l=lang();document.querySelectorAll('[data-en][data-es]').forEach(el=>el.textContent=el.dataset[l]);document.querySelectorAll('[data-content-en][data-content-es]').forEach(el=>el.textContent=l==='es'?el.dataset.contentEs:el.dataset.contentEn);document.querySelectorAll('[data-value]').forEach(el=>{const v=el.dataset.value;el.textContent=l==='es'?(valueES[v.toLowerCase()]||v):v});renderFollow();filter()}
function filter(){const t=q.value.trim().toLowerCase(),c=commodity.value,r=region.value.toLowerCase(),s=stage.value.toLowerCase(),d=deal.value.toLowerCase();let n=0;cards.forEach(x=>{const ok=(!t||x.dataset.search.includes(t))&&(!c||x.dataset.commodities.includes(c))&&(!r||x.dataset.region===r)&&(!s||x.dataset.stage.includes(s))&&(!d||x.dataset.deal.includes(d))&&(!followingOnly||followSet.has(x.dataset.project));x.hidden=!ok;if(ok)n++});count.textContent=lang()==='es'?n+' OPORTUNIDAD'+(n===1?'':'ES'):n+' OPPORTUNIT'+(n===1?'Y':'IES');empty.style.display=n?'none':'block'}[q,commodity,region,stage,deal].forEach(x=>x.addEventListener(x===q?'input':'change',filter));window.addEventListener('pyorex-language',translateHub);translateHub();
</script>
<style>.ticker{background:#061419;border-bottom:1px solid #294249}.metals{display:grid;grid-template-columns:repeat(5,1fr) 1.35fr}.metal,.market-source{min-height:78px;padding:14px 18px;border-right:1px solid #294249;display:flex;align-items:center;gap:13px}.metal>b{color:#efbd35;font:700 15px ui-monospace,monospace}.metal strong{display:block;font-size:17px}.metal small,.market-source small,.market-source span{display:block;color:#718b8d;font:9px ui-monospace,monospace;letter-spacing:.07em}.metal em{margin-left:auto;color:#63817e;font:8px ui-monospace,monospace}.market-source{display:block;padding-top:21px}.market-source span{margin-top:7px;color:#aab8b7}@media(max-width:850px){.metals{grid-template-columns:repeat(3,1fr)}.market-source{display:none}}
.hub{padding:92px 0 100px;background:#07171b}.wrap{max-width:1500px;margin:auto;padding:0 42px}.eyebrow{font:700 12px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:#efbd35}.intro{display:flex;justify-content:space-between;gap:40px;align-items:end;margin:16px 0 44px}.intro h1{font-size:clamp(48px,6vw,84px);line-height:.98;margin:0 0 20px;letter-spacing:-.045em}.intro p{max-width:850px;color:#b9c6c8;font-size:20px;line-height:1.55;margin:0}.archive-link,.brief-link,.support a{color:#efbd35;text-decoration:none;font:700 12px ui-monospace,monospace;letter-spacing:.1em;white-space:nowrap}.command-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #294249;margin:0 0 26px;background:#061419}.command-strip>div{padding:18px 20px;border-right:1px solid #294249}.command-strip>div:last-child{border-right:0}.command-strip small{display:block;color:#718b8d;font:9px ui-monospace,monospace;letter-spacing:.11em}.command-strip strong{display:block;margin-top:7px;font-size:22px}.intel-review-count{margin-top:8px!important;line-height:1.4!important;letter-spacing:0!important}.command-strip .live-dot{font:700 12px ui-monospace,monospace;color:#efbd35;letter-spacing:.08em}.section-kicker{display:flex;justify-content:space-between;margin:0 0 10px;color:#efbd35;font:700 10px ui-monospace,monospace;letter-spacing:.12em}.section-kicker span:last-child{color:#718b8d}.search{height:66px;border:1px solid #355057;display:flex;align-items:center;padding:0 22px;gap:14px;background:#061419}.search span{color:#efbd35;font-size:22px}.search input{width:100%;border:0;outline:0;background:transparent;color:#edf0e9;font-size:17px}.latest-intelligence{border:1px solid #294249;background:#091a1f;padding:24px;margin:0 0 30px}.latest-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:12px}.latest-heading small{color:#efbd35;font:10px ui-monospace,monospace;letter-spacing:.1em}.latest-heading h2{font-size:29px;margin:9px 0}.latest-heading a,.feed-source{color:#efbd35;font:10px ui-monospace,monospace;text-decoration:none}.latest-feed article{display:grid;grid-template-columns:110px 1fr 80px;gap:18px;border-top:1px solid #294249;padding:16px 0}.feed-date,.latest-feed small{color:#718b8d;font:10px ui-monospace,monospace}.latest-feed h3{margin:5px 0;font-size:19px}.latest-feed p{margin:3px 0;color:#d5ddda;font-size:13px}.feed-summary{color:#9fb0b1;font-size:12px;line-height:1.5}.latest-meta{color:#718b8d;font:10px ui-monospace,monospace;margin-top:12px}@media(max-width:650px){.latest-feed article{grid-template-columns:1fr}.latest-heading{display:block}.latest-heading a{display:block;margin:12px 0}}.follow-toolbar{display:flex;align-items:center;gap:16px;margin:12px 0}.follow-toolbar button{background:#0b2226;color:#efbd35;border:1px solid #385158;padding:11px 16px;font:700 11px ui-monospace,monospace;cursor:pointer}.follow-toolbar button.active,.follow-project[aria-pressed="true"]{background:#efbd35;color:#07171b;border-color:#efbd35}.follow-toolbar small{color:#718b8d;font:10px ui-monospace,monospace}.follow-project{cursor:pointer;color:#efbd35!important}.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.filters select{height:48px;background:#061419;border:1px solid #294249;color:#c8d1d0;padding:0 16px;font:11px ui-monospace,monospace;letter-spacing:.04em}.meta{display:flex;justify-content:space-between;border-bottom:1px solid #284047;padding:24px 0 18px;color:#718b8d;font:10px ui-monospace,monospace;letter-spacing:.12em}.meta span:first-child{color:#efbd35}.list{display:grid;gap:12px;margin-top:20px}.card{display:grid;grid-template-columns:1.05fr 1.55fr 1.45fr auto;gap:28px;align-items:center;border:1px solid #294249;background:#091a1f;padding:25px 26px}.card[hidden]{display:none}.identity small,.assessment small,.facts small{display:block;color:#708b8d;font:10px ui-monospace,monospace;letter-spacing:.11em}.identity h2{font-size:28px;margin:5px 0 3px}.identity h2 a:hover{c