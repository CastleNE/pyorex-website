---
import Base from '../layouts/Base.astro';
import data from '../data/opportunities.json';
import projects from '../data/projects.json';

---
<Base title="PyOrex HUB — Exploration Intelligence"><link rel="stylesheet" href="/vendor/leaflet.css"/><script src="/vendor/leaflet.js"></script>
<section class="ticker"><div class="wrap metals"><div class="metal" data-metal="Au"><b>Au</b><div><strong>—</strong><small>USD/oz</small></div><em>LIVE</em></div><div class="metal" data-metal="Ag"><b>Ag</b><div><strong>—</strong><small>USD/oz</small></div><em>LIVE</em></div><div class="metal" data-metal="Cu"><b>Cu</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="metal" data-metal="Zn"><b>Zn</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="metal" data-metal="Pb"><b>Pb</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="market-source"><small>MARKET WATCH</small><span id="market-status">Loading live prices…</span></div></div></section><section class="opp"><div class="wrap"><div class="hero-grid"><div class="hero-search"><div class="eyebrow">PROJECT RADAR</div><h2 class="radar-title">Search the mineral landscape.</h2><p class="lead">Search projects, deposits and mines. PyOrex keeps the geological entity in focus; source databases remain in the background.</p><div class="searchbox"><span>⌕</span><input id="project-search" placeholder="Search project, mine, company, district..."/></div><div class="advanced"><select id="commodity"><option value="">COMMODITY · ALL</option><option>Au</option><option>Ag</option><option>Cu</option><option>Zn</option><option>Pb</option></select><select id="size"><option value="">DEPOSIT SIZE · ALL</option><option>Occurrence / prospect</option><option>Small</option><option>Medium</option><option>Large</option><option>World-class</option></select><select id="style"><option value="">MINERALIZATION · ALL</option><option>Porphyry</option><option>Epithermal</option><option>CRD</option><option>Skarn</option><option>IOCG</option><option>VMS</option></select><select id="owner"><option value="">OWNER TYPE · ALL</option><option>Junior</option><option>Mid-tier</option><option>Major</option><option>Private</option><option>State</option></select></div><div class="meta">PROJECTS + DEPOSITS + MINES · SOURCE-TRACEABLE · UPDATED {projects.updated_at}</div></div><div class="hero-map"><div id="project-map" aria-label="Interactive PyOrex mineral viewer"></div><div class="mapbar"><b>MAP VIEW</b><span id="map-state">PROJECTS + MINES</span></div><div class="mapfilters" id="map-filters"><button class="active" data-metal="">ALL</button><button data-metal="Au">Au</button><button data-metal="Ag">Ag</button><button data-metal="Cu">Cu</button><button data-metal="Zn">Zn</button><button data-metal="Pb">Pb</button><label class="occ-toggle"><input id="occurrences-toggle" type="checkbox"/> OCCURRENCES</label></div></div></div><div class="radar-legend"><span><i class="primary-dot"></i> CURATED ENTITY</span><span><i class="context-dot"></i> SOURCE CONTEXT</span><span>OCCURRENCES OFF BY DEFAULT</span></div><div class="rule"></div><div class="catalog" id="knowledge-list">{projects.items.map(x=><article class="knowledge-card" data-project={(x.name+" "+x.operator+" "+x.country+" "+x.region+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.mineralization_style+" "+x.entity_type).toLowerCase()} data-commodities={x.commodities.join(" ")} data-style={x.mineralization_style} data-owner={x.owner_type} data-size={x.deposit_size}><div><small>PYOREX KNOWLEDGE BASE · {x.entity_type.replace("_"," ").toUpperCase()}</small><h2>{x.name}</h2><p>{x.region} · {x.country} · {x.commodities.join("–")} · {x.mineralization_style}</p></div><div class="knowledge-actions"><a href={"/hub/projects/"+x.slug}>VIEW PROJECT →</a><button class="brief" data-name={x.name}>INTELLIGENCE BRIEF <b>PRO</b></button></div></article>)}</div><div class="list" id="project-list">{data.items.map(x=><article class="project-card" data-project={(x.project+" "+x.company+" "+x.country+" "+x.region+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage).toLowerCase()} data-commodities={x.commodities.join(" ")} data-style={x.deposit_model} data-owner={(x.owner_type||"").toLowerCase()} data-size={(x.deposit_size||"").toLowerCase()}><div class="side"><strong>{x.country}</strong><span>{x.region}</span><small>{x.opportunity_type.toUpperCase()}</small></div><div class="body"><div class="company">{x.company} · {x.project}</div><h2>{x.headline}</h2><div class="chips">{x.commodities.map(v=><i>{v}</i>)}<i>{x.stage}</i><i>{x.deposit_model}</i></div><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><div class="actions"><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a><button class="brief" data-name={x.project}>GENERATE INTELLIGENCE BRIEF <b>PRO</b></button></div></div></article>)}</div><div id="no-results" class="no-results">No projects match this search.</div></div></section><section class="hub-news"><div class="wrap"><div class="news-head"><div><div class="eyebrow">LATEST EXPLORATION INTELLIGENCE</div><h2>What changed. Why it matters.</h2></div><a href="/hub/brief">WEEKLY BRIEF →</a></div><div class="news-grid"><a href="/hub/discoveries"><small>DISCOVERIES</small><strong>New discoveries & drilling</strong><span>Material results and emerging exploration stories worth following.</span></a><a href="/hub/methods"><small>METHODS</small><strong>Exploration methods</strong><span>Practical workflows, targeting approaches and emerging tools.</span></a><a href="/hub/research"><small>RESEARCH</small><strong>Papers worth reading</strong><span>High-signal technical literature translated into exploration implications.</span></a><a href="/hub/andes"><small>ANDES & PERU</small><strong>Andean intelligence</strong><span>Regional geology, datasets, projects and exploration developments.</span></a></div></div></section><section class="pro"><div class="wrap"><div class="eyebrow">PYOREX INTELLIGENCE · PRO</div><h2>Project Intelligence Brief</h2><p class="prolead">Historical background · geology · mineralization · exploration programs · drilling · targets · PyOrex synthesis · source index.</p><div class="package"><div><b>△ PYOREX</b><span>PROJECT INTELLIGENCE</span></div><strong>PDF / DOCX</strong><strong>+ SOURCE PACKAGE</strong></div><div class="disclaimer"><b>AI-GENERATED EXPLORATION INTELLIGENCE</b><p>PyOrex HUB uses artificial intelligence to synthesize public technical information. AI-generated content may contain errors, omissions or incorrect interpretations. Geological and factual statements should be checked against cited original sources before technical, economic or investment decisions. Source documents are included when redistribution is permitted; otherwise the original reference and access link are provided.</p></div></div></section><script is:inline>
(async()=>{const status=document.getElementById('market-status');try{const r=await fetch('/api/metals'),d=await r.json();if(!r.ok||d.status!=='success')throw new Error();for(const [symbol,item] of Object.entries(d.metals)){const el=document.querySelector(`[data-metal="${symbol}"]`);if(!el)continue;const decimals=(symbol==='Au'||symbol==='Ag')?2:3;el.querySelector('strong').textContent=Number(item.price).toLocaleString('en-US',{minimumFractionDigits:decimals,maximumFractionDigits:decimals});el.querySelector('small').textContent=item.unit;}const t=d.timestamp?new Date(d.timestamp):null;status.textContent=t&&!Number.isNaN(t.valueOf())?`Metals.Dev · ${t.toLocaleString([], {dateStyle:'medium',timeStyle:'short'})}`:'Metals.Dev · live';}catch(e){status.textContent='Market data temporarily unavailable';document.querySelectorAll('.metal em').forEach(x=>x.textContent='—')}})();
const input=document.getElementById("project-search"),commodity=document.getElementById("commodity"),size=document.getElementById("size"),style=document.getElementById("style"),owner=document.getElementById("owner"),cards=[...document.querySelectorAll(".project-card,.knowledge-card")],empty=document.getElementById("no-results"),occToggle=document.getElementById("occurrences-toggle"),mapState=document.getElementById("map-state");let mapMetal="",occLoaded=false;
const curated=[
{slug:"pierina",name:"Pierina",country:"Peru",region:"Ancash",commodities:["Au","Ag"],entity_type:"historic_mine",longitude:-77.58,latitude:-9.45},
{slug:"ayawilca",name:"Ayawilca",country:"Peru",region:"Pasco",commodities:["Zn","Ag","Sn"],entity_type:"project",longitude:-76.45,latitude:-10.55},
{slug:"colquemayo",name:"Colquemayo",country:"Peru",region:"Moquegua",commodities:["Cu","Au","Mo"],entity_type:"project",longitude:-70.55,latitude:-16.65},
{slug:"esperanza",name:"Esperanza",country:"Peru",region:"Arequipa",commodities:["Cu","Au","Mo"],entity_type:"project",longitude:-72.25,latitude:-15.55},
{slug:"sombrero",name:"Sombrero",country:"Peru",region:"Ayacucho",commodities:["Cu","Au"],entity_type:"project",longitude:-74.15,latitude:-14.25},
{slug:"san-pietro",name:"San Pietro",country:"Chile",region:"Atacama",commodities:["Cu","Au"],entity_type:"project",longitude:-70.25,latitude:-27.25}
];
const map=window.L.map("project-map",{zoomControl:true,attributionControl:true,minZoom:3,maxZoom:18}).setView([-11.5,-75.2],5);
window.L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap contributors"}).addTo(map);
const projectLayer=window.L.layerGroup().addTo(map),occurrenceLayer=window.L.layerGroup().addTo(map);
function projectIcon(){return window.L.divIcon({className:"py-project-wrap",html:'<span class="project-marker"></span>',iconSize:[18,18],iconAnchor:[9,9]})}
const projectMarkers=curated.map(p=>{const popup='<div class="py-popup"><b>'+p.name+'</b><span>'+p.region+' · '+p.country+'</span><small>'+p.commodities.join(" · ")+' · '+p.entity_type.replace("_"," ")+'</small>'+(p.slug==="pierina"?'<a href="/hub/projects/pierina">VIEW PROJECT →</a>':"")+'</div>';const marker=window.L.marker([p.latitude,p.longitude],{icon:projectIcon()}).bindPopup(popup).addTo(projectLayer);return {p,marker}});
function filterCards(){const q=(input?.value||"").toLowerCase().trim(),m=commodity?.value||mapMetal,s=(size?.value||"").toLowerCase(),st=(style?.value||"").toLowerCase(),o=(owner?.value||"").toLowerCase();let n=0;cards.forEach(c=>{const ok=(!q||c.dataset.project.includes(q))&&(!m||c.dataset.commodities.split(" ").includes(m))&&(!s||c.dataset.size===s)&&(!st||c.dataset.style.toLowerCase().includes(st))&&(!o||c.dataset.owner===o);c.style.display=ok?"grid":"none";if(ok)n++});empty.style.display=n?"none":"block"}
[input,commodity,size,style,owner].forEach(el=>el?.addEventListener("input",filterCards));
function refreshCurated(){projectLayer.clearLayers();projectMarkers.forEach(({p,marker})=>{if(!mapMetal||p.commodities.includes(mapMetal))marker.addTo(projectLayer)})}
document.querySelectorAll("#map-filters button").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll("#map-filters button").forEach(x=>x.classList.remove("active"));b.classList.add("active");mapMetal=b.dataset.metal||"";if(commodity)commodity.value=mapMetal;filterCards();refreshCurated();if(occToggle?.checked)loadOccurrences(true)}));
async function loadOccurrences(){
 occurrenceLayer.clearLayers();
 if(!occToggle?.checked){mapState.textContent="PROJECTS + MINES";return}
 mapState.textContent="LOADING OCCURRENCES…";
 try{const metal=commodity?.value||mapMetal,b=map.getBounds(),bbox=[b.getWest(),b.getSouth(),b.getEast(),b.getNorth()].join(","),url="/api/ingemmet/occurrences?layer=metallic&limit=1000&bbox="+encodeURIComponent(bbox)+(metal?"&commodity="+encodeURIComponent(metal):""),r=await fetch(url),j=await r.json();if(!r.ok)throw new Error(j?.error||"INGEMMET");let n=0;(j.items||[]).forEach(x=>{const lon=Number(x.longitude??x.lon),lat=Number(x.latitude??x.lat);if(!Number.isFinite(lon)||!Number.isFinite(lat))return;window.L.circleMarker([lat,lon],{radius:3,weight:1,color:"#73837e",fillColor:"#a8b6b1",fillOpacity:.65}).bindTooltip((x.name||"INGEMMET occurrence")+" · "+(x.commodities||[]).join(" ")).addTo(occurrenceLayer);n++});mapState.textContent="PROJECTS + MINES + "+n+" OCCURRENCES"}catch(e){mapState.textContent="OCCURRENCES UNAVAILABLE"}}
occToggle?.addEventListener("change",()=>loadOccurrences());map.on("moveend",()=>{if(occToggle?.checked)loadOccurrences()});commodity?.addEventListener("change",()=>{mapMetal=commodity.value;document.querySelectorAll("#map-filters button").forEach(x=>x.classList.toggle("active",(x.dataset.metal||"")===mapMetal));filterCards();refreshCurated();if(occToggle?.checked)loadOccurrences(true)});
document.querySelectorAll(".brief").forEach(b=>{b.title="Unavailable · In development";b.setAttribute("aria-disabled","true");b.addEventListener("click",()=>alert("PyOrex Intelligence Brief · "+b.dataset.name+"\n\nUNAVAILABLE · IN DEVELOPMENT"))});filterCards();
</script>
</Base>
<style>.opp{min-height:760px;padding:42px 0;background:radial-gradient(circle at 80% 10%,#2a3027,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.opp h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:820px}.filters,.chips{display:flex;gap:8px;flex-wrap:wrap}.filters{margin-top:28px}.filters span,.chips i{border:1px solid var(--line);padding:7px 10px;font-size:9px;letter-spacing:.1em}.meta{margin-top:25px;color:var(--gold);font-size:9px;letter-spacing:.13em}.rule{height:1px;background:var(--line);margin:45px 0 22px}.list{display:grid;gap:12px}.list article{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);background:#0b1a20}.side{padding:25px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.side strong{font-size:17px}.side span{color:var(--muted);font-size:11px}.side small{color:var(--gold);font-size:9px;margin-top:auto}.body{padding:25px}.company{font-size:10px;color:var(--gold);letter-spacing:.08em}.body h2{font-size:22px;margin:10px 0 14px}.chips i{font-style:normal;color:var(--muted)}.body h3{font-size:9px;letter-spacing:.13em;color:#829297;margin:22px 0 7px}.body p{color:#b4c0c2;line-height:1.65;font-size:13px;max-width:950px}.body a{display:inline-block;margin-top:13px;font-size:11px;font-weight:700}@media(max-width:700px){.list article{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}}.searchbox{margin-top:30px;max-width:900px;height:55px;border:1px solid #52646a;background:#0a191e;display:flex;align-items:center;padding:0 17px;gap:12px}.searchbox span{font-size:22px;color:var(--gold)}.searchbox input{width:100%;background:none;border:0;outline:0;color:#fff;font-size:14px}.actions{display:flex;justify-content:space-between;align-items:center;gap:12px}.brief{border:0;background:var(--gold);padding:10px 12px;font-size:9px;font-weight:800;cursor:not-allowed;opacity:.78;position:relative}.brief:after{content:"UNAVAILABLE";font-size:7px;letter-spacing:.08em;margin-left:7px;color:#51400f}.brief b{background:#111;color:#fff;padding:3px 5px;margin-left:5px}.no-results{display:none;padding:30px;border:1px solid var(--line);color:var(--muted)}.pro{background:#e8e5dc;color:#111;padding:75px 0}.pro h2{font-size:52px;letter-spacing:-.05em;margin:15px 0}.prolead{font-size:16px;max-width:800px}.package{margin-top:35px;background:#fff;padding:25px;max-width:700px;display:flex;align-items:center;gap:30px;box-shadow:0 12px 40px #0002}.package div{margin-right:auto}.package div span{display:block;font-size:8px;letter-spacing:.13em;margin-top:5px}.package>strong{font-size:11px}.disclaimer{margin-top:45px;border-top:1px solid #aaa;padding-top:18px;max-width:1000px}.disclaimer>b{font-size:9px;letter-spacing:.12em}.disclaimer p{font-size:10px;line-height:1.6;color:#555}@media(max-width:700px){.actions,.package{align-items:flex-start;flex-direction:column}}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(330px,.75fr);gap:52px;align-items:center}.hero-search{min-width:0}.hero-map{height:570px;border-left:1px solid var(--line);position:relative;background:#0a1515;overflow:hidden}#project-map{position:absolute;inset:0}.maplibregl-canvas{outline:none}.maplibregl-ctrl-attrib{font-size:9px!important;background:rgba(7,18,22,.78)!important;color:#aab4b2!important}.maplibregl-ctrl-attrib a{color:#d2d7d5!important}.maplibregl-ctrl-group{background:#0b191d!important;border:1px solid #34433f!important}.maplibregl-ctrl-group button+button{border-top:1px solid #34433f!important}.maplibregl-ctrl-icon{filter:invert(1);opacity:.7}#project-map{position:absolute;inset:0;width:100%;height:100%;background:#d9d7cf;filter:saturate(.62) brightness(.78)}.py-project-wrap{background:transparent;border:0}.project-marker{display:block;pointer-events:auto}.project-pop{position:absolute;z-index:5;transform:translate(12px,-50%);width:170px;background:#0b191d;color:#eef0ea;border:1px solid #43524e;padding:11px;display:flex;flex-direction:column;gap:4px;pointer-events:auto}.project-pop span,.project-pop small{font-size:9px;color:#aab5b3}.project-pop a{font-size:8px;color:#e5b84b;margin-top:4px}.project-marker{width:16px;height:16px;border-radius:50%;border:2px solid #071216;background:#e5b84b;box-shadow:0 0 0 7px rgba(229,184,75,.18);cursor:pointer;padding:0}.project-marker:hover{transform:scale(1.3)}.leaflet-popup-content-wrapper{background:#0b191d;color:#eef0ea;border:1px solid #43524e;border-radius:2px}.leaflet-popup-tip{background:#0b191d}.py-popup{display:flex;flex-direction:column;gap:4px;min-width:155px}.py-popup b{font-size:15px}.py-popup span,.py-popup small{color:#aab5b3;font-size:10px}.py-popup a{color:#e5b84b;font-size:9px;font-weight:800;margin-top:5px}.mapbar{position:absolute;top:18px;left:20px;right:58px;z-index:2;background:rgba(7,18,22,.76);padding:8px 10px;pointer-events:none;display:flex;justify-content:space-between;font-size:8px;letter-spacing:.13em}.mapbar b{color:var(--gold)}.mapbar span{color:#71817c}.mapfilters{position:absolute;left:20px;right:20px;bottom:20px;display:flex;gap:5px;flex-wrap:wrap}.mapfilters button{background:#0b1716;color:#899a95;border:1px solid #34433f;padding:7px 10px;font-size:8px}.mapfilters button.active{background:var(--gold);color:#08110f;border-color:var(--gold)}.advanced{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px;max-width:900px}.advanced select{background:#0a191e;color:#aab6b8;border:1px solid var(--line);padding:11px 12px;font-size:9px;letter-spacing:.07em;outline:0}@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-map{height:430px;border-left:0;border-top:1px solid var(--line)}#project-map{height:100%}}@media(max-width:600px){.advanced{grid-template-columns:1fr}}.occ-toggle{display:flex;align-items:center;gap:6px;margin-left:auto;border-left:1px solid #34433f;padding-left:10px;color:#899a95;font-size:8px;letter-spacing:.08em}.occ-toggle input{accent-color:var(--gold)}.mapfilters{z-index:3;background:rgba(7,18,22,.82);padding:7px}.catalog{display:grid;gap:12px;margin-bottom:12px}.knowledge-card{border:1px solid #6d6849;background:linear-gradient(90deg,#151d1c,#0b191d);padding:24px;display:flex;justify-content:space-between;align-items:center;gap:25px}.knowledge-card small{font-size:8px;letter-spacing:.13em;color:var(--gold)}.knowledge-card h2{font-size:28px;margin:8px 0 5px}.knowledge-card p{margin:0;color:#9dacaf;font-size:12px}.knowledge-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.knowledge-actions>a{border:1px solid var(--line);padding:11px 13px;font-size:9px;font-weight:800;white-space:nowrap}@media(max-width:700px){.knowledge-card{align-items:flex-start;flex-direction:column}}.radar-legend{display:flex;gap:18px;flex-wrap:wrap;margin-top:30px;color:#73827f;font-size:8px;letter-spacing:.1em}.radar-legend span{display:flex;align-items:center;gap:7px}.radar-legend i{width:6px;height:6px;border-radius:50%;display:inline-block}.primary-dot{background:var(--gold)}.context-dot{background:#7c8a86}.ticker{background:#050d10;border-bottom:1px solid var(--line)}.metals{height:68px;display:flex;align-items:stretch}.metal{min-width:145px;flex:1;display:flex;align-items:center;gap:12px;border-right:1px solid var(--line);padding:9px 15px}.metal>b{font-size:20px}.metal strong{display:block;font-size:14px}.metal small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.metal em{font-style:normal;color:#49d979;font-size:10px;margin-left:auto}.market-source{width:175px;display:flex;justify-content:center;flex-direction:column;padding-left:18px;color:var(--muted)}.market-source span,.market-source small{font-size:8px}.hub-head{padding:54px 0 42px;border-bottom:1px solid var(--line);margin-bottom:42px}.hub-head h1{font-size:clamp(46px,5vw,76px);letter-spacing:-.055em;line-height:.95;margin:15px 0}.hub-head p{color:#b8c4c5;font-size:17px;max-width:720px;line-height:1.55}.radar-title{font-size:clamp(36px,4vw,58px);line-height:.95;letter-spacing:-.045em;margin:17px 0 22px}.hub-news{padding:70px 0;background:#09171c;border-top:1px solid var(--line)}.news-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.news-head h2{font-size:38px;letter-spacing:-.04em;margin:10px 0 0}.news-head>a{font-size:10px;color:var(--gold);font-weight:800}.news-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.news-grid>a{min-height:175px;padding:23px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column}.news-grid small{font-size:8px;letter-spacing:.12em;color:var(--gold)}.news-grid strong{font-size:17px;margin:14px 0 9px}.news-grid span{font-size:11px;line-height:1.55;color:var(--muted)}@media(max-width:900px){.metals{overflow:auto}.market-source{display:none}.news-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.news-grid{grid-template-columns:1fr}} </style>