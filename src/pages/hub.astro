---
import Base from '../layouts/Base.astro';
import data from '../data/opportunities.json';
import majors from '../data/major-signals.json';
const items=data.items;
---
<Base title="PyOrex HUB — New Opportunities">
<section class="ticker"><div class="wrap metals"><div class="metal" data-metal="Au"><b>Au</b><div><strong>—</strong><small>USD/oz</small></div><em>LIVE</em></div><div class="metal" data-metal="Ag"><b>Ag</b><div><strong>—</strong><small>USD/oz</small></div><em>LIVE</em></div><div class="metal" data-metal="Cu"><b>Cu</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="metal" data-metal="Zn"><b>Zn</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="metal" data-metal="Pb"><b>Pb</b><div><strong>—</strong><small>USD/lb</small></div><em>LIVE</em></div><div class="market-source"><small>MARKET WATCH</small><span id="market-status">Loading live prices…</span></div></div></section><section class="hub">
 <div class="wrap">
  <div class="eyebrow">PYOREX HUB · NEW OPPORTUNITIES</div>
  <div class="intro"><div><h1>Find the next opportunity.</h1><p>A focused scouting screen of junior-controlled Peruvian projects, transactions and strategic watchlist assets. Availability is reported only when supported by a public source.</p></div></div>
  <div class="search"><span>⌕</span><input id="q" placeholder="Search company, project, region, commodity..."/></div>
  <div class="filters">
   <select id="commodity"><option value="">COMMODITY · ALL</option><option>Au</option><option>Ag</option><option>Cu</option><option>Zn</option><option>Pb</option></select>
   <select id="region"><option value="">REGION · ALL</option><option>North</option><option>Central</option><option>South</option></select>
   <select id="stage"><option value="">STAGE · ALL</option><option>Early-stage</option><option>Exploration</option><option>Resource</option><option>Advanced</option></select>
   <select id="deal"><option value="">DEAL · ALL</option><option>JV</option><option>Option</option><option>Acquisition</option><option>Strategic watch</option></select>
  </div>
  <div class="meta"><span id="count">{items.length} OPPORTUNITIES</span><span>PERU JUNIORS · SOURCE-TRACEABLE · UPDATED 2026-10-04</span></div>
  <div id="list" class="list">
   {items.map(x=><article class="card" data-search={(x.company+" "+x.project+" "+x.region+" "+x.country+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage+" "+(x.association_type||"")+" "+(x.opportunity_rating||"")).toLowerCase()} data-commodities={x.commodities.join(" ")} data-region={(x.macro_region||"").toLowerCase()} data-stage={x.stage.toLowerCase()} data-deal={(x.association_type||"").toLowerCase()}>
    <div class="identity"><small>{x.company}</small><h2>{x.project}</h2><span>{x.region} · {x.country}</span><div class="chips">{x.commodities.map(v=><i>{v}</i>)}</div></div>
    <div class="assessment"><small>PYOREX SCREENING</small><strong>{x.opportunity_rating||x.opportunity_type}</strong><p>{x.why_it_matters}</p></div>
    <div class="facts"><div><small>DEPOSIT STYLE</small><b>{x.deposit_model}</b></div><div><small>STAGE</small><b>{x.stage}</b></div><div><small>ASSOCIATION</small><b>{x.association_type||"Strategic watch"}</b></div><div><small>AVAILABILITY</small><b>{x.availability_status||"Not publicly marketed"}</b></div></div>
    <div class="actions"><a href={x.source_url} target="_blank" rel="noopener">PRIMARY SOURCE ↗</a><button class="brief" data-name={x.project}>INTELLIGENCE BRIEF <b>PRO</b><em>UNAVAILABLE</em></button></div>
   </article>)}
  </div>
  <div id="empty" class="empty">No opportunities match these filters.</div>
 </div>
</section>
<section class="majors"><div class="wrap"><div class="major-head"><div><div class="eyebrow">MAJOR COMPANY SIGNALS</div><h2>Moves worth watching.</h2><p>Selected exploration programs, major–junior partnerships and transactions that may reshape opportunity flow.</p></div></div><div class="major-grid">{majors.items.map(x=><article><div class="major-meta"><span>{x.category}</span><time>{x.date}</time></div><small>{x.company} · {x.region}</small><h3>{x.headline}</h3><p>{x.signal}</p><div class="major-why"><b>WHY IT MATTERS</b><span>{x.why_it_matters}</span></div><a href={x.source_url} target="_blank" rel="noopener">PRIMARY SOURCE · {x.source_name} ↗</a></article>)}</div></div></section>
<script>
(async()=>{const status=document.getElementById("market-status");try{const r=await fetch("/api/metals"),d=await r.json();if(!r.ok||d.status!=="success")throw new Error();for(const [symbol,item] of Object.entries(d.metals)){const el=document.querySelector(`[data-metal="${symbol}"]`);if(!el)continue;const decimals=(symbol==="Au"||symbol==="Ag")?2:3;el.querySelector("strong").textContent=Number(item.price).toLocaleString("en-US",{minimumFractionDigits:decimals,maximumFractionDigits:decimals});el.querySelector("small").textContent=item.unit}status.textContent="Metals.Dev · live"}catch(e){status.textContent="Market data temporarily unavailable"}})();
const q=document.getElementById("q"),commodity=document.getElementById("commodity"),region=document.getElementById("region"),stage=document.getElementById("stage"),deal=document.getElementById("deal"),cards=[...document.querySelectorAll(".card")],count=document.getElementById("count"),empty=document.getElementById("empty");
function filter(){const t=q.value.trim().toLowerCase(),c=commodity.value,r=region.value.toLowerCase(),s=stage.value.toLowerCase(),d=deal.value.toLowerCase();let n=0;cards.forEach(x=>{const ok=(!t||x.dataset.search.includes(t))&&(!c||x.dataset.commodities.includes(c))&&(!r||x.dataset.region===r)&&(!s||x.dataset.stage.includes(s))&&(!d||x.dataset.deal.includes(d));x.hidden=!ok;if(ok)n++});count.textContent=n+" OPPORTUNIT"+(n===1?"Y":"IES");empty.style.display=n?"none":"block"}[q,commodity,region,stage,deal].forEach(x=>x.addEventListener(x===q?"input":"change",filter));
</script>
<style>.ticker{background:#061419;border-bottom:1px solid #294249}.metals{display:grid;grid-template-columns:repeat(5,1fr) 1.35fr}.metal,.market-source{min-height:78px;padding:14px 18px;border-right:1px solid #294249;display:flex;align-items:center;gap:13px}.metal>b{color:#efbd35;font:700 15px ui-monospace,monospace}.metal strong{display:block;font-size:17px}.metal small,.market-source small,.market-source span{display:block;color:#718b8d;font:9px ui-monospace,monospace;letter-spacing:.07em}.metal em{margin-left:auto;color:#63817e;font:8px ui-monospace,monospace}.market-source{display:block;padding-top:21px}.market-source span{margin-top:7px;color:#aab8b7}@media(max-width:850px){.metals{grid-template-columns:repeat(3,1fr)}.market-source{display:none}}
.hub{padding:92px 0 100px;background:#07171b}.wrap{max-width:1500px;margin:auto;padding:0 42px}.eyebrow{font:700 12px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:#efbd35}.intro{display:flex;justify-content:space-between;gap:40px;align-items:end;margin:16px 0 44px}.intro h1{font-size:clamp(48px,6vw,84px);line-height:.98;margin:0 0 20px;letter-spacing:-.045em}.intro p{max-width:850px;color:#b9c6c8;font-size:20px;line-height:1.55;margin:0}.brief-link,.support a{color:#efbd35;text-decoration:none;font:700 12px ui-monospace,monospace;letter-spacing:.1em;white-space:nowrap}.search{height:66px;border:1px solid #355057;display:flex;align-items:center;padding:0 22px;gap:14px;background:#061419}.search span{color:#efbd35;font-size:22px}.search input{width:100%;border:0;outline:0;background:transparent;color:#edf0e9;font-size:17px}.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.filters select{height:48px;background:#061419;border:1px solid #294249;color:#c8d1d0;padding:0 16px;font:11px ui-monospace,monospace;letter-spacing:.04em}.meta{display:flex;justify-content:space-between;border-bottom:1px solid #284047;padding:24px 0 18px;color:#718b8d;font:10px ui-monospace,monospace;letter-spacing:.12em}.meta span:first-child{color:#efbd35}.list{display:grid;gap:12px;margin-top:20px}.card{display:grid;grid-template-columns:1.05fr 1.55fr 1.45fr auto;gap:28px;align-items:center;border:1px solid #294249;background:#091a1f;padding:25px 26px}.card[hidden]{display:none}.identity small,.assessment small,.facts small{display:block;color:#708b8d;font:10px ui-monospace,monospace;letter-spacing:.11em}.identity h2{font-size:28px;margin:5px 0 3px}.identity span{color:#94a6a7;font-size:13px}.chips{display:flex;gap:5px;margin-top:12px}.chips i{font-style:normal;font:10px ui-monospace,monospace;border:1px solid #385158;padding:5px 7px}.assessment strong{display:block;color:#efbd35;margin:7px 0 8px;font:700 12px ui-monospace,monospace;letter-spacing:.08em}.assessment p{color:#aebbbc;line-height:1.5;margin:0;font-size:14px}.facts{display:grid;gap:10px}.facts b{font-size:13px;font-weight:500;color:#d8ded9}.actions{display:grid;gap:8px;min-width:190px}.actions a,.actions button{border:1px solid #385158;background:transparent;color:#dce1dc;padding:11px 13px;text-align:left;text-decoration:none;font:10px ui-monospace,monospace;letter-spacing:.06em}.actions button{color:#efbd35}.actions em{display:block;color:#718487;font-size:8px;margin-top:4px}.empty{display:none;padding:50px 0;color:#819496}.majors{padding:72px 0;background:#08191d;border-top:1px solid #294249}.major-head h2{font-size:40px;margin:10px 0}.major-head p{color:#9fb0b1;max-width:780px}.major-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:28px}.major-grid article{border:1px solid #294249;background:#091a1f;padding:24px}.major-meta{display:flex;justify-content:space-between;color:#efbd35;font:10px ui-monospace,monospace;letter-spacing:.08em}.major-grid article>small{display:block;color:#708b8d;margin:14px 0 6px;font:10px ui-monospace,monospace}.major-grid h3{font-size:21px;line-height:1.25;margin:0 0 12px}.major-grid p{color:#aebbbc;line-height:1.55;font-size:14px}.major-why{border-top:1px solid #233b41;margin-top:16px;padding-top:14px;display:grid;gap:6px}.major-why b{color:#efbd35;font:9px ui-monospace,monospace;letter-spacing:.1em}.major-why span{color:#9fb0b1;font-size:13px;line-height:1.5}.major-grid a{display:inline-block;margin-top:18px;color:#cfd8d5;text-decoration:none;font:9px ui-monospace,monospace;letter-spacing:.06em}.support{padding:70px 0;background:#0b1c20;border-top:1px solid #294249}.support .wrap{display:flex;justify-content:space-between;align-items:center;gap:40px}.support h2{font-size:36px;margin:10px 0}.support p{max-width:820px;color:#9fb0b1;line-height:1.6;margin:0}@media(max-width:950px){.major-grid{grid-template-columns:1fr}.intro,.support .wrap{display:block}.brief-link{display:inline-block;margin-top:24px}.filters{grid-template-columns:1fr 1fr}.card{grid-template-columns:1fr}.actions{grid-template-columns:1fr 1fr}.meta{gap:20px}.wrap{padding:0 20px}}@media(max-width:560px){.filters{grid-template-columns:1fr}.actions{grid-template-columns:1fr}.hub{padding-top:60px}}
</style>
</Base>