---
import Base from '../layouts/Base.astro';
import data from '../data/opportunities.json';
const items=data.items;
---
<Base title="PyOrex HUB — New Opportunities">
<section class="hub">
 <div class="wrap">
  <div class="eyebrow">PYOREX HUB · NEW OPPORTUNITIES</div>
  <div class="intro"><div><h1>Find the next opportunity.</h1><p>A focused scouting screen of junior-controlled Peruvian projects, transactions and strategic watchlist assets. Availability is reported only when supported by a public source.</p></div><a class="brief-link" href="/hub/brief">EXPLORATION BRIEF →</a></div>
  <div class="search"><span>⌕</span><input id="q" placeholder="Search company, project, region, commodity..."/></div>
  <div class="filters">
   <select id="commodity"><option value="">COMMODITY · ALL</option><option>Au</option><option>Ag</option><option>Cu</option><option>Zn</option><option>Pb</option></select>
   <select id="region"><option value="">REGION · ALL</option><option>North</option><option>Central</option><option>South</option></select>
   <select id="stage"><option value="">STAGE · ALL</option><option>Early-stage</option><option>Exploration</option><option>Resource</option><option>Advanced</option></select>
   <select id="deal"><option value="">DEAL · ALL</option><option>JV</option><option>Option</option><option>Acquisition</option><option>Strategic watch</option></select>
  </div>
  <div class="meta"><span id="count">{items.length} OPPORTUNITIES</span><span>PERU JUNIORS · SOURCE-TRACEABLE · UPDATED 2026-10-04</span></div>
  <div id="list" class="list">
   {items.map(x=><article class="card" data-search={(x.company+" "+x.project+" "+x.region+" "+x.country+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage+" "+(x.association_type||"")+" "+(x.opportunity_rating||"")).toLowerCase()} data-commodities={x.commodities.join(" ")} data-region={(x.macro_region||"").toLowerCase()} data-stage={x.stage.toLowerCase()} data-deal={(x.association_type||"").toLowerCase()}>
    <div class="identity"><small>{x.company}</small><h2>{x.project}</h2><span>{x.region} · {x.country}</span><div class="chips">{x.commodities.map(v=><i>{v}</i>)}</div></div>
    <div class="assessment"><small>PYOREX SCREENING</small><strong>{x.opportunity_rating||x.opportunity_type}</strong><p>{x.why_it_matters}</p></div>
    <div class="facts"><div><small>DEPOSIT STYLE</small><b>{x.deposit_model}</b></div><div><small>STAGE</small><b>{x.stage}</b></div><div><small>ASSOCIATION</small><b>{x.association_type||"Strategic watch"}</b></div><div><small>AVAILABILITY</small><b>{x.availability_status||"Not publicly marketed"}</b></div></div>
    <div class="actions"><a href={x.source_url} target="_blank" rel="noopener">PRIMARY SOURCE ↗</a><button class="brief" data-name={x.project}>INTELLIGENCE BRIEF <b>PRO</b><em>UNAVAILABLE</em></button></div>
   </article>)}
  </div>
  <div id="empty" class="empty">No opportunities match these filters.</div>
 </div>
</section>
<section class="support"><div class="wrap"><div><div class="eyebrow">EXPLORATION BRIEF</div><h2>Technical context, without the noise.</h2><p>The HUB remains a supporting intelligence layer: selected exploration developments, methods and papers that can materially affect targeting or opportunity screening.</p></div><a href="/hub/brief">READ LATEST BRIEF →</a></div></section>
<script>
const q=document.getElementById("q"),commodity=document.getElementById("commodity"),region=document.getElementById("region"),stage=document.getElementById("stage"),deal=document.getElementById("deal"),cards=[...document.querySelectorAll(".card")],count=document.getElementById("count"),empty=document.getElementById("empty");
function filter(){const t=q.value.trim().toLowerCase(),c=commodity.value,r=region.value.toLowerCase(),s=stage.value.toLowerCase(),d=deal.value.toLowerCase();let n=0;cards.forEach(x=>{const ok=(!t||x.dataset.search.includes(t))&&(!c||x.dataset.commodities.includes(c))&&(!r||x.dataset.region===r)&&(!s||x.dataset.stage.includes(s))&&(!d||x.dataset.deal.includes(d));x.hidden=!ok;if(ok)n++});count.textContent=n+" OPPORTUNIT"+(n===1?"Y":"IES");empty.style.display=n?"none":"block"}[q,commodity,region,stage,deal].forEach(x=>x.addEventListener(x===q?"input":"change",filter));
</script>
<style>
.hub{padding:92px 0 100px;background:#07171b}.wrap{max-width:1500px;margin:auto;padding:0 42px}.eyebrow{font:700 12px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:#efbd35}.intro{display:flex;justify-content:space-between;gap:40px;align-items:end;margin:16px 0 44px}.intro h1{font-size:clamp(48px,6vw,84px);line-height:.98;margin:0 0 20px;letter-spacing:-.045em}.intro p{max-width:850px;color:#b9c6c8;font-size:20px;line-height:1.55;margin:0}.brief-link,.support a{color:#efbd35;text-decoration:none;font:700 12px ui-monospace,monospace;letter-spacing:.1em;white-space:nowrap}.search{height:66px;border:1px solid #355057;display:flex;align-items:center;padding:0 22px;gap:14px;background:#061419}.search span{color:#efbd35;font-size:22px}.search input{width:100%;border:0;outline:0;background:transparent;color:#edf0e9;font-size:17px}.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.filters select{height:48px;background:#061419;border:1px solid #294249;color:#c8d1d0;padding:0 16px;font:11px ui-monospace,monospace;letter-spacing:.04em}.meta{display:flex;justify-content:space-between;border-bottom:1px solid #284047;padding:24px 0 18px;color:#718b8d;font:10px ui-monospace,monospace;letter-spacing:.12em}.meta span:first-child{color:#efbd35}.list{display:grid;gap:12px;margin-top:20px}.card{display:grid;grid-template-columns:1.05fr 1.55fr 1.45fr auto;gap:28px;align-items:center;border:1px solid #294249;background:#091a1f;padding:25px 26px}.card[hidden]{display:none}.identity small,.assessment small,.facts small{display:block;color:#708b8d;font:10px ui-monospace,monospace;letter-spacing:.11em}.identity h2{font-size:28px;margin:5px 0 3px}.identity span{color:#94a6a7;font-size:13px}.chips{display:flex;gap:5px;margin-top:12px}.chips i{font-style:normal;font:10px ui-monospace,monospace;border:1px solid #385158;padding:5px 7px}.assessment strong{display:block;color:#efbd35;margin:7px 0 8px;font:700 12px ui-monospace,monospace;letter-spacing:.08em}.assessment p{color:#aebbbc;line-height:1.5;margin:0;font-size:14px}.facts{display:grid;gap:10px}.facts b{font-size:13px;font-weight:500;color:#d8ded9}.actions{display:grid;gap:8px;min-width:190px}.actions a,.actions button{border:1px solid #385158;background:transparent;color:#dce1dc;padding:11px 13px;text-align:left;text-decoration:none;font:10px ui-monospace,monospace;letter-spacing:.06em}.actions button{color:#efbd35}.actions em{display:block;color:#718487;font-size:8px;margin-top:4px}.empty{display:none;padding:50px 0;color:#819496}.support{padding:70px 0;background:#0b1c20;border-top:1px solid #294249}.support .wrap{display:flex;justify-content:space-between;align-items:center;gap:40px}.support h2{font-size:36px;margin:10px 0}.support p{max-width:820px;color:#9fb0b1;line-height:1.6;margin:0}@media(max-width:950px){.intro,.support .wrap{display:block}.brief-link{display:inline-block;margin-top:24px}.filters{grid-template-columns:1fr 1fr}.card{grid-template-columns:1fr}.actions{grid-template-columns:1fr 1fr}.meta{gap:20px}.wrap{padding:0 20px}}@media(max-width:560px){.filters{grid-template-columns:1fr}.actions{grid-template-columns:1fr}.hub{padding-top:60px}}
</style>
</Base>