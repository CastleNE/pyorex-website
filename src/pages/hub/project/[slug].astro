---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/opportunities.json';
export function getStaticPaths(){return data.items.map(item=>({params:{slug:item.slug||item.project.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')},props:{item}}))}
const {item}=Astro.props;
const slug=item.slug||item.project.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
---
<Base title={item.project+' — PyOrex HUB'}>
<section class="project"><div class="wrap"><a class="back" href="/hub">← PYOREX HUB</a>
<header><div><div class="eyebrow"><span data-i18n="projectRecord">PROJECT RECORD</span> · {item.country.toUpperCase()}</div><h1>{item.project}</h1><p>{item.company} · {item.region}, {item.country}</p><div class="chips">{item.commodities.map(v=><i>{v}</i>)}</div></div><div class="status"><small data-i18n="lastMaterialUpdate">LAST MATERIAL UPDATE</small><strong id="last">Loading…</strong><span id="period">D1 LIVE</span></div></header>
<div class="grid"><aside><div><small data-i18n="depositStyle">DEPOSIT STYLE</small><b>{item.deposit_model}</b></div><div><small data-i18n="stageLabel">STAGE</small><b>{item.stage}</b></div><div><small data-i18n="statusAssociation">STATUS / ASSOCIATION</small><b>{item.association_type||'Strategic watch'}</b></div><div><small data-i18n="publicAvailability">PUBLIC AVAILABILITY</small><b>{item.availability_status||'Not publicly marketed'}</b></div><div><small>PYOREX SCREENING</small><b class="gold">{item.opportunity_rating||item.opportunity_type}</b></div></aside>
<main><div class="timeline-head"><div><div class="eyebrow" data-i18n="historicalTimeline">HISTORICAL TIMELINE</div><h2 data-i18n="projectSignals">Project signals</h2></div><span id="count">LOADING…</span></div><div id="events"></div><div class="note"><b data-i18n="archiveStatus">ARCHIVE STATUS</b><p data-i18n="archiveStatusText">This project record is persistent. Material events are read from the PyOrex HUB database; new events are appended and previous events are retained.</p></div></main></div></div></section>
<script define:vars={{slug}} is:inline>
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let currentLang=localStorage.getItem('pyorex-lang')||'en', archiveData=null;
const ui={en:{verified:'VERIFIED EVENT',primary:'PRIMARY SOURCE',open:'OPEN PRIMARY SOURCE ↗',unavailable:'ARCHIVE UNAVAILABLE'},es:{verified:'EVENTO VERIFICADO',primary:'FUENTE PRIMARIA',open:'ABRIR FUENTE PRIMARIA ↗',unavailable:'ARCHIVO NO DISPONIBLE'}};
function render(d){archiveData=d;const t=ui[currentLang];document.getElementById('count').textContent=d.count+' '+t.verified+(d.count===1?'':'S');document.getElementById('events').innerHTML=d.items.map(e=>`<article class="event"><div class="date"><b>${esc(e.event_date)}</b><span>Q${esc(e.quarter)} ${esc(e.year)}</span></div><div><small>${esc(e.event_type).toUpperCase()} · ${esc(e.source_name)} · ${t.primary}</small><h3>${esc(e.title)}</h3><p>${esc(e.summary||e.why_it_matters||'')}</p><a href="${esc(e.source_url)}" target="_blank" rel="noopener">${t.open}</a></div></article>`).join('')}
window.addEventListener('pyorex-language',e=>{currentLang=e.detail.lang;if(archiveData)render(archiveData)});
fetch('/api/hub/project/'+encodeURIComponent(slug)).then(async r=>{const d=await r.json();if(!r.ok)throw new Error(d.message||'Project archive unavailable');if(d.items.length){const x=d.items[0];document.getElementById('last').textContent=x.event_date;document.getElementById('period').textContent='Q'+x.quarter+' '+x.year} render(d);}).catch(e=>{document.getElementById('count').textContent='ARCHIVE UNAVAILABLE';document.getElementById('events').innerHTML='<p>'+esc(e.message)+'</p>'});
</script>
<style>.project{padding:70px 0 110px;background:#07171b;min-height:80vh}.back{font:10px ui-monospace,monospace;color:#94a6a7;letter-spacing:.1em}.project header{display:flex;justify-content:space-between;gap:50px;align-items:end;padding:45px 0 35px;border-bottom:1px solid #294249}.project h1{font-size:clamp(52px,7vw,92px);margin:10px 0 8px;letter-spacing:-.05em}.project header p{color:#9fb0b1;margin:0}.chips{display:flex;gap:6px;margin-top:16px}.chips i{font-style:normal;border:1px solid #385158;padding:5px 8px;font:10px ui-monospace,monospace}.status{text-align:right}.status small,aside small,.event small{display:block;color:#708b8d;font:9px ui-monospace,monospace;letter-spacing:.1em}.status strong{display:block;font-size:20px;margin:8px 0}.status span{color:#efbd35;font:11px ui-monospace,monospace}.grid{display:grid;grid-template-columns:300px 1fr;gap:70px;padding-top:38px}aside{display:grid;align-content:start;gap:24px}aside div{border-bottom:1px solid #233b41;padding-bottom:18px}aside b{display:block;margin-top:6px;font-size:14px;font-weight:500}.gold{color:#efbd35}.timeline-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #294249;padding-bottom:18px}.timeline-head h2{font-size:32px;margin:8px 0 0}.timeline-head>span{font:9px ui-monospace,monospace;color:#718b8d}.event{display:grid;grid-template-columns:150px 1fr;gap:30px;padding:30px 0;border-bottom:1px solid #294249}.date b{display:block;font:12px ui-monospace,monospace;color:#efbd35}.date span{font:10px ui-monospace,monospace;color:#718b8d}.event h3{font-size:23px;margin:7px 0 10px}.event p{color:#aebbbc;line-height:1.6;max-width:850px}.event a{display:inline-block;margin-top:8px;font:10px ui-monospace,monospace;color:#efbd35;letter-spacing:.06em}.note{margin-top:35px;border:1px solid #294249;padding:20px;color:#83999a}.note b{font:9px ui-monospace,monospace;color:#efbd35}.note p{margin:7px 0 0;line-height:1.5}@media(max-width:800px){.project header{align-items:start;flex-direction:column}.status{text-align:left}.grid{grid-template-columns:1fr;gap:40px}.event{grid-template-columns:1fr}}</style>
</Base>