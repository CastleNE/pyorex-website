---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/opportunities.json';
import archive from '../../../data/project-events.json';
export function getStaticPaths(){return data.items.map(item=>({params:{slug:item.slug||item.project.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')},props:{item}}))}
const {item}=Astro.props;
const dt=new Date(item.published_at+'T00:00:00');
const q='Q'+(Math.floor(dt.getUTCMonth()/3)+1);
const events=archive.items.filter(e=>e.project===item.project).sort((a,b)=>b.date.localeCompare(a.date));
if(!events.length)events.push({project:item.project,date:item.published_at,type:'Project update',title:item.headline,summary:item.why_it_matters,source_name:item.source_name,source_url:item.source_url});
const last=events[0];
---
<Base title={item.project+' — PyOrex HUB'}>
<section class="project"><div class="wrap">
<a class="back" href="/hub">← PYOREX HUB</a>
<header><div><div class="eyebrow">PROJECT RECORD · {item.country.toUpperCase()}</div><h1>{item.project}</h1><p>{item.company} · {item.region}, {item.country}</p><div class="chips">{item.commodities.map(v=><i>{v}</i>)}</div></div><div class="status"><small>LAST MATERIAL UPDATE</small><strong>{last.date}</strong><span>{'Q'+(Math.floor(new Date(last.date+'T00:00:00').getUTCMonth()/3)+1)} {new Date(last.date+'T00:00:00').getUTCFullYear()}</span></div></header>
<div class="grid">
<aside><div><small>DEPOSIT STYLE</small><b>{item.deposit_model}</b></div><div><small>STAGE</small><b>{item.stage}</b></div><div><small>STATUS / ASSOCIATION</small><b>{item.association_type||'Strategic watch'}</b></div><div><small>PUBLIC AVAILABILITY</small><b>{item.availability_status||'Not publicly marketed'}</b></div><div><small>PYOREX SCREENING</small><b class="gold">{item.opportunity_rating||item.opportunity_type}</b></div></aside>
<main><div class="timeline-head"><div><div class="eyebrow">HISTORICAL TIMELINE</div><h2>Project signals</h2></div><span>{events.length} VERIFIED EVENT{events.length===1?'':'S'}</span></div>
{events.map(e=>{const d=new Date(e.date+'T00:00:00'),eq='Q'+(Math.floor(d.getUTCMonth()/3)+1);return <article class="event"><div class="date"><b>{e.date}</b><span>{eq} {d.getUTCFullYear()}</span></div><div><small>{e.type.toUpperCase()} · {e.source_name} · PRIMARY SOURCE</small><h3>{e.title}</h3><p>{e.summary}</p><a href={e.source_url} target="_blank" rel="noopener">OPEN PRIMARY SOURCE ↗</a></div></article>})}
<div class="note"><b>ARCHIVE STATUS</b><p>This project record is now persistent. New material events will be appended to this timeline; previous events will not be overwritten.</p></div>
</main></div>
</div></section>
<style>.project{padding:70px 0 110px;background:#07171b;min-height:80vh}.back{font:10px ui-monospace,monospace;color:#94a6a7;letter-spacing:.1em}.project header{display:flex;justify-content:space-between;gap:50px;align-items:end;padding:45px 0 35px;border-bottom:1px solid #294249}.project h1{font-size:clamp(52px,7vw,92px);margin:10px 0 8px;letter-spacing:-.05em}.project header p{color:#9fb0b1;margin:0}.chips{display:flex;gap:6px;margin-top:16px}.chips i{font-style:normal;border:1px solid #385158;padding:5px 8px;font:10px ui-monospace,monospace}.status{text-align:right}.status small,aside small,.event small{display:block;color:#708b8d;font:9px ui-monospace,monospace;letter-spacing:.1em}.status strong{display:block;font-size:20px;margin:8px 0}.status span{color:#efbd35;font:11px ui-monospace,monospace}.grid{display:grid;grid-template-columns:300px 1fr;gap:70px;padding-top:38px}aside{display:grid;align-content:start;gap:24px}aside div{border-bottom:1px solid #233b41;padding-bottom:18px}aside b{display:block;margin-top:6px;font-size:14px;font-weight:500}.gold{color:#efbd35}.timeline-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #294249;padding-bottom:18px}.timeline-head h2{font-size:32px;margin:8px 0 0}.timeline-head>span{font:9px ui-monospace,monospace;color:#718b8d}.event{display:grid;grid-template-columns:150px 1fr;gap:30px;padding:30px 0;border-bottom:1px solid #294249}.date b{display:block;font:12px ui-monospace,monospace;color:#efbd35}.date span{font:10px ui-monospace,monospace;color:#718b8d}.event h3{font-size:23px;margin:7px 0 10px}.event p{color:#aebbbc;line-height:1.6;max-width:850px}.event a{display:inline-block;margin-top:8px;font:10px ui-monospace,monospace;color:#efbd35;letter-spacing:.06em}.note{margin-top:28px;border:1px solid #294249;padding:18px 20px;color:#718b8d;font:10px/1.6 ui-monospace,monospace}.note b{color:#efbd35}.note p{margin:5px 0 0}@media(max-width:800px){.project header{display:block}.status{text-align:left;margin-top:28px}.grid{grid-template-columns:1fr;gap:35px}.event{grid-template-columns:1fr}.project{padding-top:45px}}</style>
</Base>