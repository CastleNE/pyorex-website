---
import Base from '../../../layouts/Base.astro';
import projects from '../../../data/projects.json';
export function getStaticPaths(){return projects.items.map(project=>({params:{slug:project.slug},props:{project}}))}
const {project}=Astro.props;
---
<Base title={project.name+" — PyOrex HUB"}>
<section class="project"><div class="wrap"><a class="back" href="/hub/opportunities">← Project Radar</a><div class="top"><div><div class="eyebrow">{project.entity_type.replace("_"," ").toUpperCase()} · {project.country.toUpperCase()}</div><h1>{project.name}</h1><p class="lead">{project.region} · {project.commodities.join("–")} · {project.mineralization_style}</p><div class="chips"><i>{project.status}</i><i>{project.deposit_size}</i><i>{project.owner_type}</i><i>{project.operator}</i></div></div><div class="briefbox"><small>PYOREX HUB PRO</small><strong>Intelligence Brief</strong><span>Geology · mineralization · history · exploration · sources</span><button class="brief">GENERATE BRIEF <b>PRO</b></button></div></div><div class="grid"><main><section><h2>Overview</h2><p>{project.summary}</p></section><section><h2>Geological setting</h2><p>{project.geology}</p></section><section><h2>Mineralization</h2><p>{project.mineralization}</p></section><section><h2>History</h2><p>{project.history}</p></section></main><aside><h3>PROJECT SNAPSHOT</h3><dl><dt>Type</dt><dd>{project.entity_type.replace("_"," ")}</dd><dt>Commodity</dt><dd>{project.commodities.join(" · ")}</dd><dt>Deposit model</dt><dd>{project.deposit_model}</dd><dt>Style</dt><dd>{project.mineralization_style}</dd><dt>Owner type</dt><dd>{project.owner_type}</dd><dt>Operator</dt><dd>{project.operator}</dd><dt>Status</dt><dd>{project.status}</dd></dl><h3>EVIDENCE</h3><div class="evidence"><b>DOCUMENTED</b><span>Public technical sources</span></div><h3>SOURCES</h3>{project.sources.map(s=><a class="source" href={s.url} target="_blank" rel="noopener"><b>{s.id}</b><span>{s.name}</span>↗</a>)}</aside></div><div class="ai"><b>AI-GENERATED EXPLORATION INTELLIGENCE</b><span>PyOrex synthesizes public technical information. Verify geological and factual statements against the original sources before technical, economic or investment decisions.</span></div></div></section><script is:inline>document.querySelector(".brief")?.addEventListener("click",()=>alert("PyOrex Intelligence Brief · PRO\n\nReport generation and evidence package are being prepared."));</script>
</Base>
<style>.project{padding:75px 0 90px;background:radial-gradient(circle at 80% 5%,#293028,#071216 42%);min-height:100vh}.back{color:var(--muted);font-size:12px}.top{display:grid;grid-template-columns:1fr 330px;gap:50px;align-items:end;margin:70px 0 55px}.project h1{font-size:clamp(70px,10vw,140px);line-height:.8;letter-spacing:-.07em;margin:18px 0 30px}.lead{font-size:18px;color:#bdc7c9}.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:22px}.chips i{font-style:normal;border:1px solid var(--line);padding:7px 10px;font-size:9px;text-transform:uppercase;color:#9ba9ab}.briefbox{border:1px solid var(--line);padding:25px;background:#0b191d;display:flex;flex-direction:column;gap:9px}.briefbox small{color:var(--gold);letter-spacing:.12em}.briefbox strong{font-size:24px}.briefbox span{font-size:11px;line-height:1.5;color:var(--muted)}.brief{margin-top:12px;background:var(--gold);border:0;padding:12px;font-size:9px;font-weight:800;cursor:pointer}.brief b{background:#111;color:#fff;padding:3px 5px;margin-left:5px}.grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:70px;border-top:1px solid var(--line);padding-top:45px}main section{padding:0 0 36px;margin-bottom:36px;border-bottom:1px solid var(--line)}main h2{font-size:28px;margin:0 0 14px}main p{font-size:15px;line-height:1.8;color:#b8c3c5;max-width:850px}aside h3{font-size:9px;letter-spacing:.14em;color:var(--gold);margin:0 0 15px}dl{margin:0 0 40px}dt{font-size:8px;color:#718187;text-transform:uppercase;letter-spacing:.1em;margin-top:14px}dd{margin:3px 0 0;font-size:13px;text-transform:capitalize}.source{display:grid;grid-template-columns:30px 1fr 15px;gap:8px;padding:11px 0;border-top:1px solid var(--line);font-size:10px;line-height:1.4}.source b{color:var(--gold)}.source span{color:#aebabc}.ai{margin-top:60px;border-top:1px solid var(--line);padding-top:18px;display:flex;gap:25px;font-size:9px;color:#718187}.ai b{color:#a5b0b1;white-space:nowrap}@media(max-width:800px){.top,.grid{grid-template-columns:1fr}.top{gap:25px}.ai{flex-direction:column;gap:8px}}.evidence{display:flex;justify-content:space-between;gap:10px;border:1px solid #4b594f;padding:10px 11px;margin:-4px 0 30px;font-size:8px;letter-spacing:.08em}.evidence b{color:var(--gold)}.evidence span{color:#82908c}</style>