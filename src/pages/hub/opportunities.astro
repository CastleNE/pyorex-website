---
import Base from '../../layouts/Base.astro';
import data from '../../data/opportunities.json';
---
<Base title="New Opportunities — PyOrex HUB">
<section class="opp"><div class="wrap"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PROJECTS · DEALS · GROUND · CAPITAL</div><h1>New<br/>Opportunities</h1><p class="lead">A searchable radar of junior-controlled exploration projects worth understanding — from emerging targets to advanced mineral systems.</p><div class="searchbox"><span>⌕</span><input id="project-search" placeholder="Search project, company, region, commodity, deposit model..."/></div><div class="filters"><span>PERU & ANDES</span><span>GOLD</span><span>COPPER</span><span>JUNIORS</span><span>EARLY STAGE</span></div><div class="meta">PROJECT RADAR · UPDATED {data.updated_at} · VERIFIED AGAINST SOURCE</div><div class="rule"></div><div class="list" id="project-list">{data.items.map(x=><article class="project-card" data-project={(x.project+" "+x.company+" "+x.country+" "+x.region+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage).toLowerCase()}><div class="side"><strong>{x.country}</strong><span>{x.region}</span><small>{x.opportunity_type.toUpperCase()}</small></div><div class="body"><div class="company">{x.company} · {x.project}</div><h2>{x.headline}</h2><div class="chips">{x.commodities.map(v=><i>{v}</i>)}<i>{x.stage}</i><i>{x.deposit_model}</i></div><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><div class="actions"><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a><button class="brief" data-name={x.project}>GENERATE INTELLIGENCE BRIEF <b>PRO</b></button></div></div></article>)}</div><div id="no-results" class="no-results">No projects match this search.</div></div></section><section class="pro"><div class="wrap"><div class="eyebrow">PYOREX HUB PRO</div><h2>Project Intelligence Brief</h2><p class="prolead">Historical background · geology · mineralization · exploration programs · drilling · targets · PyOrex synthesis · source index.</p><div class="package"><div><b>△ PYOREX</b><span>PROJECT INTELLIGENCE</span></div><strong>PDF / DOCX</strong><strong>+ SOURCE PACKAGE</strong></div><div class="disclaimer"><b>AI-GENERATED EXPLORATION INTELLIGENCE</b><p>PyOrex HUB uses artificial intelligence to synthesize public technical information. AI-generated content may contain errors, omissions or incorrect interpretations. Geological and factual statements should be checked against cited original sources before technical, economic or investment decisions. Source documents are included when redistribution is permitted; otherwise the original reference and access link are provided.</p></div></div></section><script is:inline>const input=document.getElementById("project-search");const cards=[...document.querySelectorAll(".project-card")];const empty=document.getElementById("no-results");input?.addEventListener("input",()=>{const q=input.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=!q||c.dataset.project.includes(q);c.style.display=ok?"grid":"none";if(ok)n++});empty.style.display=n?"none":"block"});document.querySelectorAll(".brief").forEach(b=>b.addEventListener("click",()=>alert("PyOrex Intelligence Brief · "+b.dataset.name+"\n\nPRO feature — report generation and evidence package are being prepared.")));</script>
</Base>
<style>.opp{min-height:760px;padding:75px 0;background:radial-gradient(circle at 80% 10%,#2a3027,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.opp h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:820px}.filters,.chips{display:flex;gap:8px;flex-wrap:wrap}.filters{margin-top:28px}.filters span,.chips i{border:1px solid var(--line);padding:7px 10px;font-size:9px;letter-spacing:.1em}.meta{margin-top:25px;color:var(--gold);font-size:9px;letter-spacing:.13em}.rule{height:1px;background:var(--line);margin:45px 0 22px}.list{display:grid;gap:12px}.list article{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);background:#0b1a20}.side{padding:25px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.side strong{font-size:17px}.side span{color:var(--muted);font-size:11px}.side small{color:var(--gold);font-size:9px;margin-top:auto}.body{padding:25px}.company{font-size:10px;color:var(--gold);letter-spacing:.08em}.body h2{font-size:22px;margin:10px 0 14px}.chips i{font-style:normal;color:var(--muted)}.body h3{font-size:9px;letter-spacing:.13em;color:#829297;margin:22px 0 7px}.body p{color:#b4c0c2;line-height:1.65;font-size:13px;max-width:950px}.body a{display:inline-block;margin-top:13px;font-size:11px;font-weight:700}@media(max-width:700px){.list article{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}}.searchbox{margin-top:30px;max-width:900px;height:55px;border:1px solid #52646a;background:#0a191e;display:flex;align-items:center;padding:0 17px;gap:12px}.searchbox span{font-size:22px;color:var(--gold)}.searchbox input{width:100%;background:none;border:0;outline:0;color:#fff;font-size:14px}.actions{display:flex;justify-content:space-between;align-items:center;gap:12px}.brief{border:0;background:var(--gold);padding:10px 12px;font-size:9px;font-weight:800;cursor:pointer}.brief b{background:#111;color:#fff;padding:3px 5px;margin-left:5px}.no-results{display:none;padding:30px;border:1px solid var(--line);color:var(--muted)}.pro{background:#e8e5dc;color:#111;padding:75px 0}.pro h2{font-size:52px;letter-spacing:-.05em;margin:15px 0}.prolead{font-size:16px;max-width:800px}.package{margin-top:35px;background:#fff;padding:25px;max-width:700px;display:flex;align-items:center;gap:30px;box-shadow:0 12px 40px #0002}.package div{margin-right:auto}.package div span{display:block;font-size:8px;letter-spacing:.13em;margin-top:5px}.package>strong{font-size:11px}.disclaimer{margin-top:45px;border-top:1px solid #aaa;padding-top:18px;max-width:1000px}.disclaimer>b{font-size:9px;letter-spacing:.12em}.disclaimer p{font-size:10px;line-height:1.6;color:#555}@media(max-width:700px){.actions,.package{align-items:flex-start;flex-direction:column}}</style>