---
import Base from '../../layouts/Base.astro';
import data from '../../data/opportunities.json';
---
<Base title="New Opportunities — PyOrex HUB">
<section class="opp"><div class="wrap"><div class="hero-grid"><div class="hero-search"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PROJECTS · DEALS · GROUND · CAPITAL</div><h1>New<br/>Opportunities</h1><p class="lead">A searchable radar of junior-controlled exploration projects worth understanding — from emerging targets to advanced mineral systems.</p><div class="searchbox"><span>⌕</span><input id="project-search" placeholder="Search project, mine, company, district..."/></div><div class="advanced"><select id="commodity"><option value="">COMMODITY · ALL</option><option>Au</option><option>Ag</option><option>Cu</option><option>Zn</option><option>Pb</option></select><select id="size"><option value="">DEPOSIT SIZE · ALL</option><option>Occurrence / prospect</option><option>Small</option><option>Medium</option><option>Large</option><option>World-class</option></select><select id="style"><option value="">MINERALIZATION · ALL</option><option>Porphyry</option><option>Epithermal</option><option>CRD</option><option>Skarn</option><option>IOCG</option><option>VMS</option></select><select id="owner"><option value="">OWNER TYPE · ALL</option><option>Junior</option><option>Mid-tier</option><option>Major</option><option>Private</option><option>State</option></select></div><div class="meta">PROJECT RADAR · UPDATED {data.updated_at} · VERIFIED AGAINST SOURCE</div></div><div class="hero-map"><div class="mapbar"><b>MAP VIEW</b><span>PROJECTS + MINES</span></div><svg viewBox="0 0 500 500" aria-label="Andean project overview"><path class="continent" d="M190 15 C230 60 250 105 260 155 C270 205 295 245 320 285 C340 320 345 360 370 400 C390 435 410 470 435 495 L300 495 C275 460 255 430 240 395 C220 350 215 315 195 275 C175 235 160 190 150 145 C140 95 145 50 190 15Z"/><path class="cordillera" d="M190 30 C220 85 235 140 250 200 C265 250 285 300 310 350 C330 395 355 445 400 485"/><g class="mapdots"><circle cx="245" cy="190" r="6"/><circle cx="255" cy="235" r="6"/><circle cx="270" cy="275" r="6"/><circle cx="315" cy="365" r="6"/></g></svg><div class="mapfilters"><button class="active">ALL</button><button>Au</button><button>Ag</button><button>Cu</button><button>Zn</button><button>Pb</button></div></div></div><div class="rule"></div><div class="list" id="project-list">{data.items.map(x=><article class="project-card" data-project={(x.project+" "+x.company+" "+x.country+" "+x.region+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage).toLowerCase()}><div class="side"><strong>{x.country}</strong><span>{x.region}</span><small>{x.opportunity_type.toUpperCase()}</small></div><div class="body"><div class="company">{x.company} · {x.project}</div><h2>{x.headline}</h2><div class="chips">{x.commodities.map(v=><i>{v}</i>)}<i>{x.stage}</i><i>{x.deposit_model}</i></div><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><div class="actions"><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a><button class="brief" data-name={x.project}>GENERATE INTELLIGENCE BRIEF <b>PRO</b></button></div></div></article>)}</div><div id="no-results" class="no-results">No projects match this search.</div></div></section><section class="pro"><div class="wrap"><div class="eyebrow">PYOREX HUB PRO</div><h2>Project Intelligence Brief</h2><p class="prolead">Historical background · geology · mineralization · exploration programs · drilling · targets · PyOrex synthesis · source index.</p><div class="package"><div><b>△ PYOREX</b><span>PROJECT INTELLIGENCE</span></div><strong>PDF / DOCX</strong><strong>+ SOURCE PACKAGE</strong></div><div class="disclaimer"><b>AI-GENERATED EXPLORATION INTELLIGENCE</b><p>PyOrex HUB uses artificial intelligence to synthesize public technical information. AI-generated content may contain errors, omissions or incorrect interpretations. Geological and factual statements should be checked against cited original sources before technical, economic or investment decisions. Source documents are included when redistribution is permitted; otherwise the original reference and access link are provided.</p></div></div></section><script is:inline>const input=document.getElementById("project-search");const cards=[...document.querySelectorAll(".project-card")];const empty=document.getElementById("no-results");input?.addEventListener("input",()=>{const q=input.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=!q||c.dataset.project.includes(q);c.style.display=ok?"grid":"none";if(ok)n++});empty.style.display=n?"none":"block"});document.querySelectorAll(".brief").forEach(b=>b.addEventListener("click",()=>alert("PyOrex Intelligence Brief · "+b.dataset.name+"\n\nPRO feature — report generation and evidence package are being prepared.")));</script>
</Base>
<style>.opp{min-height:760px;padding:75px 0;background:radial-gradient(circle at 80% 10%,#2a3027,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.opp h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:820px}.filters,.chips{display:flex;gap:8px;flex-wrap:wrap}.filters{margin-top:28px}.filters span,.chips i{border:1px solid var(--line);padding:7px 10px;font-size:9px;letter-spacing:.1em}.meta{margin-top:25px;color:var(--gold);font-size:9px;letter-spacing:.13em}.rule{height:1px;background:var(--line);margin:45px 0 22px}.list{display:grid;gap:12px}.list article{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);background:#0b1a20}.side{padding:25px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.side strong{font-size:17px}.side span{color:var(--muted);font-size:11px}.side small{color:var(--gold);font-size:9px;margin-top:auto}.body{padding:25px}.company{font-size:10px;color:var(--gold);letter-spacing:.08em}.body h2{font-size:22px;margin:10px 0 14px}.chips i{font-style:normal;color:var(--muted)}.body h3{font-size:9px;letter-spacing:.13em;color:#829297;margin:22px 0 7px}.body p{color:#b4c0c2;line-height:1.65;font-size:13px;max-width:950px}.body a{display:inline-block;margin-top:13px;font-size:11px;font-weight:700}@media(max-width:700px){.list article{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}}.searchbox{margin-top:30px;max-width:900px;height:55px;border:1px solid #52646a;background:#0a191e;display:flex;align-items:center;padding:0 17px;gap:12px}.searchbox span{font-size:22px;color:var(--gold)}.searchbox input{width:100%;background:none;border:0;outline:0;color:#fff;font-size:14px}.actions{display:flex;justify-content:space-between;align-items:center;gap:12px}.brief{border:0;background:var(--gold);padding:10px 12px;font-size:9px;font-weight:800;cursor:pointer}.brief b{background:#111;color:#fff;padding:3px 5px;margin-left:5px}.no-results{display:none;padding:30px;border:1px solid var(--line);color:var(--muted)}.pro{background:#e8e5dc;color:#111;padding:75px 0}.pro h2{font-size:52px;letter-spacing:-.05em;margin:15px 0}.prolead{font-size:16px;max-width:800px}.package{margin-top:35px;background:#fff;padding:25px;max-width:700px;display:flex;align-items:center;gap:30px;box-shadow:0 12px 40px #0002}.package div{margin-right:auto}.package div span{display:block;font-size:8px;letter-spacing:.13em;margin-top:5px}.package>strong{font-size:11px}.disclaimer{margin-top:45px;border-top:1px solid #aaa;padding-top:18px;max-width:1000px}.disclaimer>b{font-size:9px;letter-spacing:.12em}.disclaimer p{font-size:10px;line-height:1.6;color:#555}@media(max-width:700px){.actions,.package{align-items:flex-start;flex-direction:column}}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(330px,.75fr);gap:52px;align-items:center}.hero-search{min-width:0}.hero-map{height:570px;border-left:1px solid var(--line);position:relative;background:radial-gradient(circle at 45% 45%,#15241f,#0a1515 72%);overflow:hidden}.hero-map svg{width:100%;height:470px;display:block}.continent{fill:#14221f;stroke:#31413d;stroke-width:1}.cordillera{fill:none;stroke:#5d6a62;stroke-width:1.4;stroke-dasharray:3 7}.mapdots circle{fill:var(--gold);stroke:#091312;stroke-width:2}.mapbar{position:absolute;top:18px;left:20px;right:20px;z-index:2;display:flex;justify-content:space-between;font-size:8px;letter-spacing:.13em}.mapbar b{color:var(--gold)}.mapbar span{color:#71817c}.mapfilters{position:absolute;left:20px;right:20px;bottom:20px;display:flex;gap:5px;flex-wrap:wrap}.mapfilters button{background:#0b1716;color:#899a95;border:1px solid #34433f;padding:7px 10px;font-size:8px}.mapfilters button.active{background:var(--gold);color:#08110f;border-color:var(--gold)}.advanced{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px;max-width:900px}.advanced select{background:#0a191e;color:#aab6b8;border:1px solid var(--line);padding:11px 12px;font-size:9px;letter-spacing:.07em;outline:0}@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-map{height:430px;border-left:0;border-top:1px solid var(--line)}.hero-map svg{height:350px}}@media(max-width:600px){.advanced{grid-template-columns:1fr}}</style>