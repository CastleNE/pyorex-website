---
import Base from '../../layouts/Base.astro';
import data from '../../data/opportunities.json';
---
<Base title="New Opportunities — PyOrex HUB">
<section class="opp"><div class="wrap"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PROJECTS · DEALS · GROUND · CAPITAL</div><h1>New<br/>Opportunities</h1><p class="lead">A searchable radar of junior-controlled exploration projects worth understanding — from emerging targets to advanced mineral systems.</p><div class="searchbox"><span>⌕</span><input id="project-search" placeholder="Search project, company, region, commodity, deposit model..."/></div><div class="filters"><span>PERU & ANDES</span><span>GOLD</span><span>COPPER</span><span>JUNIORS</span><span>EARLY STAGE</span></div><div class="meta">PROJECT RADAR · UPDATED {data.updated_at} · VERIFIED AGAINST SOURCE</div><div class="rule"></div><div class="list" id="project-list">{data.items.map(x=><article class="project-card" data-project={(x.project+" "+x.company+" "+x.country+" "+x.region+" "+x.commodities.join(" ")+" "+x.deposit_model+" "+x.stage).toLowerCase()}><div class="side"><strong>{x.country}</strong><span>{x.region}</span><small>{x.opportunity_type.toUpperCase()}</small></div><div class="body"><div class="company">{x.company} · {x.project}</div><h2>{x.headline}</h2><div class="chips">{x.commodities.map(v=><i>{v}</i>)}<i>{x.stage}</i><i>{x.deposit_model}</i></div><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><div class="actions"><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a><button class="brief" data-name={x.project}>GENERATE INTELLIGENCE BRIEF <b>PRO</b></button></div></div></article>)}</div><div id="no-results" class="no-results">No projects match this search.</div></div></section><section class="mapview"><div class="wrap"><div class="maphead"><div><div class="eyebrow">SPATIAL VIEW</div><h2>Andean Project Map</h2><p>Explore the radar spatially without turning it into a GIS.</p></div><div class="maplayers"><button class="layer active" data-layer="all">ALL</button><button class="layer" data-layer="Au">Au</button><button class="layer" data-layer="Ag">Ag</button><button class="layer" data-layer="Cu">Cu</button><button class="layer" data-layer="Zn">Zn</button><button class="layer" data-layer="Pb">Pb</button></div></div><div class="mapframe"><div class="mapnote">GENERAL VIEW · SCHEMATIC UNTIL PROJECT COORDINATES ARE VERIFIED</div><svg id="andes-map" viewBox="0 0 1000 520" role="img" aria-label="Schematic Andean project map"><defs><linearGradient id="land" x1="0" x2="1"><stop stop-color="#12262a"/><stop offset="1" stop-color="#17231f"/></linearGradient></defs><path class="land" d="M350 20 C410 70 445 115 462 165 C480 220 500 255 535 292 C565 325 575 370 605 410 C635 450 665 485 700 515 L530 515 C505 480 475 447 455 408 C430 360 420 315 390 275 C360 235 345 185 325 135 C310 95 310 55 350 20Z"/><path class="andesline" d="M352 35 C400 95 420 150 445 210 C465 260 490 300 515 345 C540 390 570 445 625 500"/><g id="map-points"><g class="pt" data-metals="Cu Au Mo" transform="translate(420 220)"><circle r="8"/><circle class="pulse" r="17"/><text x="15" y="4">Colquemayo</text></g><g class="pt" data-metals="Cu Au Mo" transform="translate(455 285)"><circle r="8"/><text x="15" y="4">Esperanza</text></g><g class="pt" data-metals="Cu Au" transform="translate(425 265)"><circle r="8"/><text x="15" y="4">Sombrero</text></g><g class="pt" data-metals="Zn Ag Sn" transform="translate(440 190)"><circle r="8"/><text x="15" y="4">Ayawilca</text></g><g class="pt" data-metals="Cu Au" transform="translate(505 405)"><circle r="8"/><text x="15" y="4">San Pietro</text></g></g><g class="labels"><text x="270" y="150">PERU</text><text x="565" y="390">CHILE</text></g></svg><div class="maplegend"><span><i></i> Tracked project</span><span class="quiet">Toggle commodities to reduce visual density</span></div></div></div></section><section class="pro"><div class="wrap"><div class="eyebrow">PYOREX HUB PRO</div><h2>Project Intelligence Brief</h2><p class="prolead">Historical background · geology · mineralization · exploration programs · drilling · targets · PyOrex synthesis · source index.</p><div class="package"><div><b>△ PYOREX</b><span>PROJECT INTELLIGENCE</span></div><strong>PDF / DOCX</strong><strong>+ SOURCE PACKAGE</strong></div><div class="disclaimer"><b>AI-GENERATED EXPLORATION INTELLIGENCE</b><p>PyOrex HUB uses artificial intelligence to synthesize public technical information. AI-generated content may contain errors, omissions or incorrect interpretations. Geological and factual statements should be checked against cited original sources before technical, economic or investment decisions. Source documents are included when redistribution is permitted; otherwise the original reference and access link are provided.</p></div></div></section><script is:inline>const input=document.getElementById("project-search");const cards=[...document.querySelectorAll(".project-card")];const empty=document.getElementById("no-results");input?.addEventListener("input",()=>{const q=input.value.toLowerCase().trim();let n=0;cards.forEach(c=>{const ok=!q||c.dataset.project.includes(q);c.style.display=ok?"grid":"none";if(ok)n++});empty.style.display=n?"none":"block"});document.querySelectorAll(".layer").forEach(btn=>btn.addEventListener("click",()=>{document.querySelectorAll(".layer").forEach(x=>x.classList.remove("active"));btn.classList.add("active");const layer=btn.dataset.layer;document.querySelectorAll("#map-points .pt").forEach(p=>{p.style.opacity=layer==="all"||p.dataset.metals.split(" ").includes(layer)?"1":".08"})}));document.querySelectorAll(".brief").forEach(b=>b.addEventListener("click",()=>alert("PyOrex Intelligence Brief · "+b.dataset.name+"\n\nPRO feature — report generation and evidence package are being prepared.")));</script>
</Base>
<style>.opp{min-height:760px;padding:75px 0;background:radial-gradient(circle at 80% 10%,#2a3027,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.opp h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:820px}.filters,.chips{display:flex;gap:8px;flex-wrap:wrap}.filters{margin-top:28px}.filters span,.chips i{border:1px solid var(--line);padding:7px 10px;font-size:9px;letter-spacing:.1em}.meta{margin-top:25px;color:var(--gold);font-size:9px;letter-spacing:.13em}.rule{height:1px;background:var(--line);margin:45px 0 22px}.list{display:grid;gap:12px}.list article{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);background:#0b1a20}.side{padding:25px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.side strong{font-size:17px}.side span{color:var(--muted);font-size:11px}.side small{color:var(--gold);font-size:9px;margin-top:auto}.body{padding:25px}.company{font-size:10px;color:var(--gold);letter-spacing:.08em}.body h2{font-size:22px;margin:10px 0 14px}.chips i{font-style:normal;color:var(--muted)}.body h3{font-size:9px;letter-spacing:.13em;color:#829297;margin:22px 0 7px}.body p{color:#b4c0c2;line-height:1.65;font-size:13px;max-width:950px}.body a{display:inline-block;margin-top:13px;font-size:11px;font-weight:700}@media(max-width:700px){.list article{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}}.searchbox{margin-top:30px;max-width:900px;height:55px;border:1px solid #52646a;background:#0a191e;display:flex;align-items:center;padding:0 17px;gap:12px}.searchbox span{font-size:22px;color:var(--gold)}.searchbox input{width:100%;background:none;border:0;outline:0;color:#fff;font-size:14px}.actions{display:flex;justify-content:space-between;align-items:center;gap:12px}.brief{border:0;background:var(--gold);padding:10px 12px;font-size:9px;font-weight:800;cursor:pointer}.brief b{background:#111;color:#fff;padding:3px 5px;margin-left:5px}.no-results{display:none;padding:30px;border:1px solid var(--line);color:var(--muted)}.pro{background:#e8e5dc;color:#111;padding:75px 0}.pro h2{font-size:52px;letter-spacing:-.05em;margin:15px 0}.prolead{font-size:16px;max-width:800px}.package{margin-top:35px;background:#fff;padding:25px;max-width:700px;display:flex;align-items:center;gap:30px;box-shadow:0 12px 40px #0002}.package div{margin-right:auto}.package div span{display:block;font-size:8px;letter-spacing:.13em;margin-top:5px}.package>strong{font-size:11px}.disclaimer{margin-top:45px;border-top:1px solid #aaa;padding-top:18px;max-width:1000px}.disclaimer>b{font-size:9px;letter-spacing:.12em}.disclaimer p{font-size:10px;line-height:1.6;color:#555}@media(max-width:700px){.actions,.package{align-items:flex-start;flex-direction:column}}.mapview{padding:70px 0;background:#081418}.maphead{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:22px}.maphead h2{font-size:42px;margin:9px 0 5px}.maphead p{color:var(--muted);margin:0}.maplayers{display:flex;gap:6px;flex-wrap:wrap}.layer{background:transparent;color:#9aa9ac;border:1px solid var(--line);padding:9px 13px;font-size:9px;cursor:pointer}.layer.active{background:var(--gold);color:#071216;border-color:var(--gold)}.mapframe{position:relative;border:1px solid var(--line);background:radial-gradient(circle at 45% 45%,#102328,#071216 70%);overflow:hidden}.mapnote{position:absolute;z-index:2;top:16px;left:18px;font-size:8px;letter-spacing:.12em;color:#74878b}.mapframe svg{display:block;width:100%;height:auto;max-height:520px}.land{fill:url(#land);stroke:#314247;stroke-width:1}.andesline{fill:none;stroke:#42585b;stroke-width:2;stroke-dasharray:3 7}.pt{transition:opacity .25s}.pt circle{fill:var(--gold);stroke:#071216;stroke-width:3}.pt .pulse{fill:none;stroke:var(--gold);stroke-width:1;opacity:.25}.pt text{fill:#d7dedf;font-size:12px}.labels text{fill:#536569;font-size:13px;letter-spacing:.18em}.maplegend{position:absolute;left:18px;bottom:16px;right:18px;display:flex;justify-content:space-between;font-size:9px;color:#94a4a7}.maplegend i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--gold);margin-right:6px}.quiet{color:#607276}@media(max-width:700px){.maphead{align-items:flex-start;flex-direction:column}.mapframe svg{min-height:330px}.maplegend{position:static;padding:12px 16px;gap:10px;flex-wrap:wrap}}</style>