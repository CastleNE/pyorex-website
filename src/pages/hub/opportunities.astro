---
import Base from '../../layouts/Base.astro';
import data from '../../data/opportunities.json';
---
<Base title="New Opportunities — PyOrex HUB">
<section class="opp"><div class="wrap"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PROJECTS · DEALS · GROUND · CAPITAL</div><h1>New<br/>Opportunities</h1><p class="lead">A filtered watchlist of exploration opportunities and strategic moves with geological relevance.</p><div class="filters"><span>PERU & ANDES</span><span>GOLD</span><span>COPPER</span><span>JUNIORS</span><span>EARLY STAGE</span></div><div class="meta">UPDATED {data.updated_at} · VERIFIED AGAINST SOURCE</div><div class="rule"></div><div class="list">{data.items.map(x=><article><div class="side"><strong>{x.country}</strong><span>{x.region}</span><small>{x.opportunity_type.toUpperCase()}</small></div><div class="body"><div class="company">{x.company} · {x.project}</div><h2>{x.headline}</h2><div class="chips">{x.commodities.map(v=><i>{v}</i>)}<i>{x.stage}</i><i>{x.deposit_model}</i></div><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a></div></article>)}</div></div></section>
</Base>
<style>.opp{min-height:760px;padding:75px 0;background:radial-gradient(circle at 80% 10%,#2a3027,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.opp h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:820px}.filters,.chips{display:flex;gap:8px;flex-wrap:wrap}.filters{margin-top:28px}.filters span,.chips i{border:1px solid var(--line);padding:7px 10px;font-size:9px;letter-spacing:.1em}.meta{margin-top:25px;color:var(--gold);font-size:9px;letter-spacing:.13em}.rule{height:1px;background:var(--line);margin:45px 0 22px}.list{display:grid;gap:12px}.list article{display:grid;grid-template-columns:190px 1fr;border:1px solid var(--line);background:#0b1a20}.side{padding:25px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.side strong{font-size:17px}.side span{color:var(--muted);font-size:11px}.side small{color:var(--gold);font-size:9px;margin-top:auto}.body{padding:25px}.company{font-size:10px;color:var(--gold);letter-spacing:.08em}.body h2{font-size:22px;margin:10px 0 14px}.chips i{font-style:normal;color:var(--muted)}.body h3{font-size:9px;letter-spacing:.13em;color:#829297;margin:22px 0 7px}.body p{color:#b4c0c2;line-height:1.65;font-size:13px;max-width:950px}.body a{display:inline-block;margin-top:13px;font-size:11px;font-weight:700}@media(max-width:700px){.list article{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--line)}}</style>