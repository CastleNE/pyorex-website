---
import Base from '../../layouts/Base.astro';
import data from '../../data/brief.json';
---
<Base title="Exploration Brief — PyOrex HUB">
<section class="brief"><div class="wrap"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PYOREX · EXPLORATION BRIEF</div><h1>Exploration<br/>Brief</h1><p class="lead">A high-signal selection of papers, reports, discoveries and methods for mineral exploration.</p><div class="meta">UPDATED {data.updated_at} · TECHNICAL FILTER · PRIMARY SOURCES PREFERRED</div><div class="rule"></div><div class="cards">{data.items.map((x,i)=><article><div class="topline"><span>{x.category.toUpperCase()}</span><small>{x.published_at}</small></div><h2>{x.title}</h2><div class="tags">{x.topics.map(t=><i>{t}</i>)}</div><h3>WHAT CHANGED</h3><p>{x.what_changed}</p><h3>WHY IT MATTERS</h3><p>{x.why_it_matters}</p><div class="read"><b>READ IF</b> {x.read_if}</div><a href={x.source_url} target="_blank" rel="noopener">Original source · {x.source_name} ↗</a></article>)}</div></div></section>
</Base>
<style>.brief{min-height:760px;padding:75px 0;background:radial-gradient(circle at 80% 10%,#19343c,#071216 45%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.brief h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:20px;line-height:1.6;color:#bdc7c9;max-width:780px}.meta{margin-top:28px;color:var(--gold);font-size:10px;letter-spacing:.15em}.rule{height:1px;background:var(--line);margin:55px 0 32px}.cards{display:grid;grid-template-columns:1fr 1fr;gap:18px}.cards article{background:#0b1a20;border:1px solid var(--line);padding:28px}.topline{display:flex;justify-content:space-between;color:var(--gold);font-size:9px;letter-spacing:.12em}.topline small{color:var(--muted)}article h2{font-size:23px;line-height:1.25;margin:15px 0}article h3{font-size:9px;letter-spacing:.14em;color:#829297;margin:23px 0 7px}article p{color:#b4c0c2;line-height:1.65;font-size:13px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tags i{font-style:normal;border:1px solid var(--line);padding:5px 7px;font-size:9px;color:var(--muted)}.read{border-top:1px solid var(--line);margin-top:20px;padding-top:15px;color:var(--muted);font-size:11px}.read b{color:var(--gold);margin-right:8px}article>a{display:inline-block;margin-top:18px;font-size:11px;font-weight:700}@media(max-width:800px){.cards{grid-template-columns:1fr}}</style>