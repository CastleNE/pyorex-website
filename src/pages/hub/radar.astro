---
import Base from '../../layouts/Base.astro';
---
<Base title="Exploration Radar — PyOrex HUB">
<section class="radar"><div class="wrap"><a class="back" href="/hub">← PyOrex HUB</a><div class="eyebrow">PYOREX · INTELLIGENCE PIPELINE</div><h1>Exploration<br/>Radar</h1><p class="lead">Candidate queue for geological review. Discovery is automatic; publication is not.</p>
<div class="stats"><div><b id="n">—</b><span>CANDIDATES</span></div><div><b id="hi">—</b><span>HIGH SIGNAL</span></div><div><b id="nw">—</b><span>NEW</span></div><div><b id="state">…</b><span>DATABASE</span></div></div>
<div class="bar"><button data-s="" class="active">ALL</button><button data-s="new">NEW</button><button data-s="reviewed">REVIEWED</button><button data-s="approved">APPROVED</button><button data-s="published">PUBLISHED</button></div>
<div id="queue" class="queue"><div class="empty">Connecting to PyOrex Radar…</div></div></div></section>
<script>
const q=document.querySelector('#queue'),state=document.querySelector('#state');
async function load(status=''){try{const r=await fetch('/api/radar/items'+(status?'?status='+status:'')),d=await r.json();if(!r.ok){state.textContent='SETUP';q.innerHTML='<div class="empty">D1 code is ready. Bind <b>PYOREX_DB</b> and apply migration 0001 to activate the queue.</div>';return}state.textContent='READY';document.querySelector('#n').textContent=d.count;document.querySelector('#hi').textContent=d.items.filter(x=>x.score>=65).length;document.querySelector('#nw').textContent=d.items.filter(x=>x.status==='new').length;q.innerHTML=d.items.length?d.items.map(x=>'<article><div class="score">'+x.score+'<small>SCORE</small></div><div><div class="meta">'+(x.category||'CANDIDATE')+' · '+(x.country||'GLOBAL')+' · '+x.status+'</div><h2>'+safe(x.title)+'</h2><p>'+safe(x.why_it_matters||x.summary||'Awaiting geological review.')+'</p><a href="'+x.canonical_url+'" target="_blank" rel="noopener">Source record ↗</a></div></article>').join(''):'<div class="empty">Database connected. No stored candidates yet.</div>'}catch{state.textContent='OFFLINE';q.innerHTML='<div class="empty">Radar API unavailable.</div>'}}
function safe(s){const d=document.createElement('div');d.textContent=String(s);return d.innerHTML}
document.querySelectorAll('.bar button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.bar button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.s)});load();
</script></Base>
<style>.radar{min-height:800px;padding:75px 0;background:radial-gradient(circle at 82% 8%,#17343a,#071216 46%)}.back{display:inline-block;color:var(--muted);font-size:12px;margin-bottom:55px}.radar h1{font-size:clamp(64px,8vw,110px);line-height:.82;letter-spacing:-.065em;margin:20px 0 28px}.lead{font-size:19px;color:#bdc7c9}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);margin:42px 0 18px}.stats div{padding:20px;border-right:1px solid var(--line)}.stats b{display:block;font-size:28px;color:var(--gold)}.stats span{font-size:8px;letter-spacing:.14em;color:var(--muted)}.bar{display:flex;gap:7px;flex-wrap:wrap;margin:20px 0}.bar button{background:transparent;border:1px solid var(--line);color:var(--muted);padding:8px 11px;font-size:9px}.bar button.active{border-color:var(--gold);color:var(--gold)}.queue{display:grid;gap:10px}.queue article{display:grid;grid-template-columns:90px 1fr;gap:22px;padding:22px;border:1px solid var(--line);background:#0b1a20}.score{font-size:32px;color:var(--gold);border-right:1px solid var(--line)}.score small{display:block;font-size:8px;color:var(--muted)}.meta{font-size:9px;color:var(--gold);text-transform:uppercase}.queue h2{font-size:18px;margin:8px 0}.queue p{font-size:12px;color:#aebabc}.empty{padding:35px;border:1px solid var(--line);color:var(--muted)}@media(max-width:700px){.stats{grid-template-columns:1fr 1fr}.queue article{grid-template-columns:1fr}}</style>