---
import Base from '../../layouts/Base.astro';
---
<Base title="PyOrex HUB — Historical Archive">
<section class="archive"><div class="wrap">
<a class="back" href="/hub">← PYOREX HUB</a><div class="eyebrow" data-en="PERMANENT INTELLIGENCE ARCHIVE" data-es="ARCHIVO PERMANENTE DE INTELIGENCIA">PERMANENT INTELLIGENCE ARCHIVE</div><h1><span data-en="Project history," data-es="Historia de proyectos,">Project history,</span><br/><span data-en="without the amnesia." data-es="sin perder la memoria.">without the amnesia.</span></h1><p class="lead" data-en="Material exploration events retained in the PyOrex HUB database. Search the permanent archive by project, company, year, quarter or event type." data-es="Eventos relevantes de exploración conservados en la base de datos de PyOrex HUB. Busca en el archivo permanente por proyecto, empresa, año, trimestre o tipo de evento.">Material exploration events retained in the PyOrex HUB database. Search the permanent archive by project, company, year, quarter or event type.</p>
<div class="search"><input id="q" placeholder="Search project, company or event..." data-en-placeholder="Search project, company or event..." data-es-placeholder="Buscar proyecto, empresa o evento..."/></div>
<div class="filters"><select id="year"><option value="" data-en="YEAR · ALL" data-es="AÑO · TODOS">YEAR · ALL</option><option>2026</option><option>2025</option></select><select id="quarter"><option value="" data-en="QUARTER · ALL" data-es="TRIMESTRE · TODOS">QUARTER · ALL</option><option value="1">Q1</option><option value="2">Q2</option><option value="3">Q3</option><option value="4">Q4</option></select><input id="type" placeholder="EVENT TYPE · ALL" data-en-placeholder="EVENT TYPE · ALL" data-es-placeholder="TIPO DE EVENTO · TODOS"/></div>
<div class="meta"><b id="count">LOADING…</b><span id="coverage">D1 · PRIMARY-SOURCE ARCHIVE</span></div>
<div id="events"></div><div id="empty" data-en="No archived events match these filters." data-es="Ningún evento archivado coincide con estos filtros.">No archived events match these filters.</div>
</div></section>
<script is:inline>
const $=id=>document.getElementById(id), box=$('events'), count=$('count'), empty=$('empty');let currentLang=localStorage.getItem('pyorex-lang')||document.documentElement.lang||'en',lastData=null;const tx={en:{loading:'LOADING…',event:'EVENT',events:'EVENTS',source:'SOURCE ↗',unavailable:'ARCHIVE UNAVAILABLE',projects:'PROJECTS',sources:'SOURCES'},es:{loading:'CARGANDO…',event:'EVENTO',events:'EVENTOS',source:'FUENTE ↗',unavailable:'ARCHIVO NO DISPONIBLE',projects:'PROYECTOS',sources:'FUENTES'}};function staticTr(){document.querySelectorAll('[data-en][data-es]').forEach(e=>e.textContent=e.dataset[currentLang]);document.querySelectorAll('[data-en-placeholder][data-es-placeholder]').forEach(e=>e.placeholder=e.dataset[currentLang+'Placeholder'])}
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){
 const p=new URLSearchParams(); if($('q').value.trim())p.set('q',$('q').value.trim()); if($('year').value)p.set('year',$('year').value); if($('quarter').value)p.set('quarter',$('quarter').value); if($('type').value.trim())p.set('type',$('type').value.trim()); p.set('limit','500');
 count.textContent=tx[currentLang].loading;
 try{const r=await fetch('/api/hub/events?'+p);const d=await r.json();if(!r.ok)throw new Error(d.message||'Archive unavailable');
 lastData=d;count.textContent=d.count+' '+(d.count===1?tx[currentLang].event:tx[currentLang].events); empty.style.display=d.count?'none':'block';
 box.innerHTML=d.items.map(e=>`<article><div class="when"><b>${esc(e.event_date)}</b><span>Q${esc(e.quarter)} ${esc(e.year)}</span></div><div class="body"><small>${esc(e.event_type).toUpperCase()} · ${esc(e.company||e.source_name)}</small><h2><a href="/hub/project/${encodeURIComponent(e.project_slug||'')}">${esc(e.project||'Unassigned')}</a></h2><h3>${esc(e.title)}</h3><p>${esc(e.summary||e.why_it_matters||'')}</p></div><a class="source" href="${esc(e.source_url)}" target="_blank" rel="noopener">${tx[currentLang].source}</a></article>`).join('');
 }catch(e){count.textContent=tx[currentLang].unavailable;box.innerHTML='<p class="error">'+esc(e.message)+'</p>'}
}
let timer; $('q').addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(load,250)});$('type').addEventListener('change',load);$('type').addEventListener('keydown',e=>{if(e.key==='Enter')load()});[$('year'),$('quarter')].forEach(x=>x.addEventListener('change',load));window.addEventListener('pyorex-language',e=>{currentLang=e.detail.lang;staticTr();load()});staticTr();load();
fetch('/api/hub/coverage').then(r=>r.json()).then(d=>{if(d.status==='success')$('coverage').textContent=d.projects+' '+tx[currentLang].projects+' · '+d.events+' '+tx[currentLang].events+' · '+d.enabled_sources+' '+tx[currentLang].sources+' · D1 LIVE'}).catch(()=>{});
</script>
<style>.archive{padding:64px 0 110px;background:#07171b;min-height:80vh}.back{display:block;margin-bottom:48px;color:#819496;font:10px ui-monospace,monospace;letter-spacing:.1em}.archive h1{font-size:clamp(48px,6vw,78px);line-height:1;margin:12px 0 18px;letter-spacing:-.045em}.lead{max-width:780px;color:#aebbbc;font-size:18px;line-height:1.6}.search{margin-top:42px;border:1px solid #355057;background:#061419}.search input,.filters input{width:100%;height:62px;background:transparent;border:0;outline:0;color:#edf0e9;padding:0 20px;font-size:16px}.filters{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}.filters select,.filters input{height:46px;background:#061419;border:1px solid #294249;color:#c8d1d0;padding:0 14px}.meta{display:flex;justify-content:space-between;padding:22px 0 15px;border-bottom:1px solid #294249;color:#718b8d;font:10px ui-monospace,monospace}.meta b{color:#efbd35}article{display:grid;grid-template-columns:140px 1fr 90px;gap:28px;padding:26px 0;border-bottom:1px solid #294249}.when b{display:block;color:#efbd35;font:11px ui-monospace,monospace}.when span,.body small{color:#708b8d;font:9px ui-monospace,monospace;letter-spacing:.08em}.body h2{font-size:24px;margin:5px 0}.body h2 a:hover{color:#efbd35}.body h3{font-size:16px;margin:0 0 8px;font-weight:500}.body p{color:#9fb0b1;line-height:1.55;margin:0;max-width:900px}.source{font:9px ui-monospace,monospace;color:#efbd35;align-self:center}#empty{display:none;padding:50px 0;color:#819496}.error{color:#d89b8c}@media(max-width:700px){.filters{grid-template-columns:1fr}article{grid-template-columns:1fr}.source{justify-self:start}}</style>
</Base>