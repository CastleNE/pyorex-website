---
import Base from '../../layouts/Base.astro';
import eventsData from '../../data/project-events.json';
const events=[...eventsData.items].sort((a,b)=>b.date.localeCompare(a.date));
const years=[...new Set(events.map(e=>e.date.slice(0,4)))].sort().reverse();
const types=[...new Set(events.map(e=>e.type))].sort();
const slug=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
---
<Base title="PyOrex HUB — Historical Archive">
<section class="archive"><div class="wrap">
<a class="back" href="/hub">← PYOREX HUB</a><div class="eyebrow">PERMANENT INTELLIGENCE ARCHIVE</div><h1>Project history,<br/>without the amnesia.</h1><p class="lead">Material exploration events are retained by project, year and quarter. New updates are appended; older signals remain searchable.</p>
<div class="search"><input id="q" placeholder="Search project, event, company or source..."/></div>
<div class="filters"><select id="year"><option value="">YEAR · ALL</option>{years.map(y=><option>{y}</option>)}</select><select id="quarter"><option value="">QUARTER · ALL</option><option value="1">Q1</option><option value="2">Q2</option><option value="3">Q3</option><option value="4">Q4</option></select><select id="type"><option value="">EVENT · ALL</option>{types.map(t=><option>{t}</option>)}</select></div>
<div class="meta"><b id="count">{events.length} EVENTS</b><span>{eventsData.updated_at} · PRIMARY-SOURCE ARCHIVE</span></div>
<div id="events">{events.map(e=>{const d=new Date(e.date+'T00:00:00'),q=Math.floor(d.getUTCMonth()/3)+1;return <article data-search={(e.project+' '+e.title+' '+e.summary+' '+e.source_name+' '+e.type).toLowerCase()} data-year={e.date.slice(0,4)} data-quarter={q} data-type={e.type}><div class="when"><b>{e.date}</b><span>Q{q} {e.date.slice(0,4)}</span></div><div class="body"><small>{e.type.toUpperCase()} · {e.source_name}</small><h2><a href={'/hub/project/'+slug(e.project)}>{e.project}</a></h2><h3>{e.title}</h3><p>{e.summary}</p></div><a class="source" href={e.source_url} target="_blank" rel="noopener">SOURCE ↗</a></article>})}</div><div id="empty">No archived events match these filters.</div>
</div></section>
<script>const q=document.getElementById('q'),y=document.getElementById('year'),qu=document.getElementById('quarter'),t=document.getElementById('type'),cards=[...document.querySelectorAll('#events article')],count=document.getElementById('count'),empty=document.getElementById('empty');function f(){let n=0;cards.forEach(c=>{const ok=(!q.value.trim()||c.dataset.search.includes(q.value.trim().toLowerCase()))&&(!y.value||c.dataset.year===y.value)&&(!qu.value||c.dataset.quarter===qu.value)&&(!t.value||c.dataset.type===t.value);c.hidden=!ok;if(ok)n++});count.textContent=n+' EVENT'+(n===1?'':'S');empty.style.display=n?'none':'block'}q.addEventListener('input',f);[y,qu,t].forEach(x=>x.addEventListener('change',f));</script>
<style>.archive{padding:64px 0 110px;background:#07171b;min-height:80vh}.back{display:block;margin-bottom:48px;color:#819496;font:10px ui-monospace,monospace;letter-spacing:.1em}.archive h1{font-size:clamp(48px,6vw,78px);line-height:1;margin:12px 0 18px;letter-spacing:-.045em}.lead{max-width:780px;color:#aebbbc;font-size:18px;line-height:1.6}.search{margin-top:42px;border:1px solid #355057;background:#061419}.search input{width:100%;height:62px;background:transparent;border:0;outline:0;color:#edf0e9;padding:0 20px;font-size:16px}.filters{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}.filters select{height:46px;background:#061419;border:1px solid #294249;color:#c8d1d0;padding:0 14px}.meta{display:flex;justify-content:space-between;padding:22px 0 15px;border-bottom:1px solid #294249;color:#718b8d;font:10px ui-monospace,monospace}.meta b{color:#efbd35}article{display:grid;grid-template-columns:140px 1fr 90px;gap:28px;padding:26px 0;border-bottom:1px solid #294249}.when b{display:block;color:#efbd35;font:11px ui-monospace,monospace}.when span,.body small{color:#708b8d;font:9px ui-monospace,monospace;letter-spacing:.08em}.body h2{font-size:24px;margin:5px 0}.body h2 a:hover{color:#efbd35}.body h3{font-size:16px;margin:0 0 8px;font-weight:500}.body p{color:#9fb0b1;line-height:1.55;margin:0;max-width:900px}.source{font:9px ui-monospace,monospace;color:#efbd35;align-self:center}#empty{display:none;padding:50px 0;color:#819496}@media(max-width:700px){.filters{grid-template-columns:1fr}article{grid-template-columns:1fr}.source{justify-self:start}}</style>
</Base>