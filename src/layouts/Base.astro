function setLang(lang){localStorage.setItem('pyorex-lang',lang);document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(dict[lang][k])el.textContent=dict[lang][k]});const b=document.getElementById('lang');if(b)b.textContent=lang==='en'?'ES':'EN';window.dispatchEvent(new CustomEvent('pyorex-language',{detail:{lang}}))}
const saved=localStorage.getItem('pyorex-lang')||'en';setLang(saved);
document.getElementById('lang')?.addEventListener('click',()=>setLang(document.documentElement.lang==='en'?'es':'en'));
</script>
