<style is:global>
:root{--bg:#071216;--panel:#0b1a20;--panel2:#0e2026;--ink:#f3f1e9;--muted:#9aa7aa;--gold:#e5b84b;--line:#24343a;--paper:#f2f1ec}*{box-sizing:border-box}html{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink)}body{margin:0}a{color:inherit;text-decoration:none}.top{height:76px;padding:0 3.2vw;display:flex;align-items:center;gap:34px;background:rgba(5,15,19,.97);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}.brand{display:flex;align-items:center;gap:11px;white-space:nowrap}.brand .mark{font-size:35px;color:var(--gold);transform:rotate(0deg)}.brand strong{font-size:27px;letter-spacing:-1px}.brand small{font-size:10px;line-height:1.3;letter-spacing:.13em;color:var(--muted);margin-left:12px}.top nav{display:flex;gap:28px;margin-left:auto;align-items:center;font-size:14px}.top nav a{padding:27px 0;border-bottom:2px solid transparent}.top nav a:hover{border-color:var(--gold)}.tools{display:flex;gap:8px}.tools button{height:38px;border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:20px;padding:0 15px}.search{min-width:120px;text-align:left;color:var(--muted)!important}.wrap{width:min(1440px,93vw);margin:auto}.eyebrow{font-size:12px;letter-spacing:.16em;font-weight:750;color:var(--gold)}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 20px;border:1px solid #6f7c80;border-radius:5px;font-size:14px;font-weight:700}.btn.gold{background:var(--gold);border-color:var(--gold);color:#101414}.grid{display:grid;gap:18px}.section{padding:70px 0}footer{min-height:74px;padding:20px 3.2vw;display:flex;align-items:center;gap:30px;border-top:1px solid var(--line);color:var(--muted);font-size:12px;background:#061014}footer .brand strong{font-size:18px;color:var(--ink)}footer .brand .mark{font-size:24px}footer nav{display:flex;gap:22px;margin-left:auto}@media(max-width:900px){.brand small,.top nav a:not(.hub),.search{display:none}.top{gap:12px}.top nav{margin-left:auto}.wrap{width:90vw}footer nav{display:none}}
</style>