---
const { title = 'PyOrex', description = 'Open tools and exploration intelligence for geoscientists.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⛏</text></svg>"/></head><body><header><a class="brand" href="/"><span>PyOrex</span></a><nav><a href="/software">Software</a><a class="hub" href="/hub">PyOrex HUB</a><a href="/docs">Docs</a><a href="https://github.com/ctarazonas/pyorex-desktop">GitHub</a><a href="/support">Support</a></nav></header><main><slot /></main><footer><div><strong>PyOrex</strong><p>Open tools and exploration intelligence for geoscientists.</p></div><div>Built for mineral exploration · 2026</div></footer></body></html>
<style is:global>
:root{--ink:#171717;--muted:#686868;--paper:#f7f6f1;--yellow:#f2c94c;--line:#d8d6ce;--white:#fff;--hub:#24392d}*{box-sizing:border-box}html{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper)}body{margin:0}a{color:inherit;text-decoration:none}header{height:74px;display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,28px);border-bottom:1px solid var(--line);background:rgba(247,246,241,.96);position:sticky;top:0;z-index:20}.brand{font-size:25px;font-weight:850;letter-spacing:-1.2px}.brand:before{content:"";display:inline-block;width:13px;height:13px;background:var(--yellow);border-radius:50%;margin-right:9px}nav{display:flex;gap:28px;align-items:center;font-size:14px;font-weight:650}nav .hub{background:var(--ink);color:white;padding:10px 15px;border-radius:4px}main{min-height:75vh}.wrap{width:min(1180px,90vw);margin:auto}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:800}.display{font-size:clamp(48px,7vw,92px);line-height:.94;letter-spacing:-.055em;margin:.2em 0}.lead{font-size:clamp(18px,2vw,24px);line-height:1.5;color:var(--muted);max-width:760px}.btn{display:inline-flex;padding:14px 19px;border:1px solid var(--ink);font-weight:750;margin-right:8px}.btn.primary{background:var(--ink);color:#fff}.btn.yellow{background:var(--yellow)}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);padding:26px}.card h3{font-size:23px;margin:0 0 10px}.card p{color:var(--muted);line-height:1.55}.section{padding:80px 0}.section-title{font-size:38px;letter-spacing:-.035em;margin:0 0 30px}footer{border-top:1px solid var(--line);padding:42px 5vw;display:flex;justify-content:space-between;color:var(--muted);font-size:13px}footer strong{color:var(--ink);font-size:18px}@media(max-width:760px){nav a:not(.hub){display:none}.display{font-size:54px}.grid{display:block}.card{margin-bottom:14px}footer{display:block}}
</style>